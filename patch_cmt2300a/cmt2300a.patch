+			return CMD_RES_BAD_ARGUMENT;
+		}
+		if(was) cmt_rx_resume();
+	}
+	ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT Frequenz RX=%u kHz TX=%u kHz", (unsigned)cmt_cur_khz(0), (unsigned)cmt_cur_khz(1));
+	return CMD_RES_OK;
+}
