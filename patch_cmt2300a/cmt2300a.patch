+/* eigene Geraete (cmtflex) */
+static struct
+{
+	int used;
+	char name[16];
+	cmt_dev_t dev;
+	uint8_t bMin, bMax, minRep;
+} s_flex[CMT_FLEX_N];
+
+static uint8_t s_devOff[CMT_DEV_MAX];
+static struct { uint32_t key, lastMs, msgs, reports, sumMs, maxMs; } s_dst[CMT_DEV_MAX];
+static uint32_t s_recTotal;
