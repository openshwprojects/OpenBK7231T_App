+/* ---- Senden ---- */
+
+/* Zeiger hinter "key": (Doppelpunkt, Leerzeichen, Anfuehrungszeichen uebersprungen) */
+static const char *cmt_json_find(const char *s, const char *key)
+{
+	char pat[24];
+	const char *p;
+
+	snprintf(pat, sizeof(pat), "\"%s\"", key);
+	p = strstr(s, pat);
+	if(!p)
+		return NULL;
+	p += strlen(pat);
+	while(*p == ' ' || *p == '\t' || *p == ':' || *p == '"')
+		p++;
+	return p;
+}
+
+static uint64_t cmt_parse_hex(const char *p)
+{
+	while(*p == ' ' || *p == '"' || *p == '#')
+		p++;
+	if(p[0] == '0' && (p[1] == 'x' || p[1] == 'X'))
+		p += 2;
+	return (uint64_t)strtoull(p, NULL, 16);
+}
+
+static commandResult_t CMD_CmtSend(const void *context, const char *cmd, const char *args, int cmdFlags)
+{
+	cmt_txreq_t r;
+	const char *p;
+	int maxRep;
+
+	if(!s_chipOk) return CMD_RES_ERROR;
+	if(!s_rxRunning)
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT TX: HW-Timer laeuft nicht, Senden nicht moeglich");
+		return CMD_RES_ERROR;
+	}
+	memset(&r, 0, sizeof(r));
+	r.bits = 24;
+	r.repeat = CMT_TX_DEF_REPEAT;
+
+	if(args && strchr(args, '{'))
+	{
+		/* JSON, z.B. {"Sync":8970,"Low":300,"High":850,"Data":"6B59A2"} oder das komplette RfReceived */
+		p = cmt_json_find(args, "Data");
+		if(!p)
+		{
+			ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT TX: \"Data\" fehlt");
+			return CMD_RES_BAD_ARGUMENT;
+		}
+		r.data = cmt_parse_hex(p);
+		if((p = cmt_json_find(args, "Sync")))   r.syncUs = atoi(p);
+		if((p = cmt_json_find(args, "Low")))    r.lowUs = atoi(p);
+		if((p = cmt_json_find(args, "High")))   r.highUs = atoi(p);
+		if((p = cmt_json_find(args, "Repeat"))) r.repeat = atoi(p);
+		if((p = cmt_json_find(args, "Bits")))   r.bits = atoi(p);
+		if((p = cmt_json_find(args, "T0H")))    r.t0h = atoi(p);
+		if((p = cmt_json_find(args, "T0L")))    r.t0l = atoi(p);
+		if((p = cmt_json_find(args, "T1H")))    r.t1h = atoi(p);
+		if((p = cmt_json_find(args, "T1L")))    r.t1l = atoi(p);
+		if((p = cmt_json_find(args, "Merged"))) r.merged = atoi(p) ? 1 : 0;
+	}
+	else
+	{
+		/* cmtsend <Data> [Wdh]  |  cmtsend <Data> <Sync> <Low> <High> [Wdh] [Bits] */
+		int argc;
+
+		Tokenizer_TokenizeString(args, 0);
+		argc = Tokenizer_GetArgsCount();
+		if(argc < 1)
+			return CMD_RES_NOT_ENOUGH_ARGUMENTS;
+		if(argc == 3)
+		{
+			ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT TX: cmtsend <Data> [Wdh] oder cmtsend <Data> <Sync> <Low> <High> [Wdh] [Bits]");
+			return CMD_RES_BAD_ARGUMENT;
+		}
+		r.data = cmt_parse_hex(Tokenizer_GetArg(0));
+		if(argc == 2)
+			r.repeat = atoi(Tokenizer_GetArg(1));
+		if(argc >= 4)
+		{
+			r.syncUs = atoi(Tokenizer_GetArg(1));
+			r.lowUs = atoi(Tokenizer_GetArg(2));
+			r.highUs = atoi(Tokenizer_GetArg(3));
+		}
+		if(argc >= 5) r.repeat = atoi(Tokenizer_GetArg(4));
+		if(argc >= 6) r.bits = atoi(Tokenizer_GetArg(5));
+	}
+
+	if(r.bits < 1 || r.bits > 64)
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT TX: Bits muss 1..64 sein");
+		return CMD_RES_BAD_ARGUMENT;
+	}
+	if(r.bits < 64)
+		r.data &= (1ULL << r.bits) - 1ULL;
+
+	/* Gar keine Zeiten angegeben und Code = zuletzt empfangener: komplette Form uebernehmen
+	 * (inkl. getrennter Pausen und "ohne Sync-Puls" bei der Klingel) */
+	if(r.syncUs <= 0 && r.lowUs <= 0 && r.highUs <= 0 && r.t0h <= 0 && r.t1h <= 0
+		&& s_lastSync > 0 && r.bits == 24 && r.data == (s_lastCode & 0xFFFFFF))
+	{
+		r.syncUs = s_lastSync;
+		r.lowUs = s_lastLow;
+		r.highUs = s_lastHigh;
+		r.t0h = s_lastLow;
+		r.t1h = s_lastHigh;
+		r.t0l = s_lastL0;      /* 0 = unbekannt -> unten aus Low/High */
+		r.t1l = s_lastL1;
+		r.merged = s_lastMerged;
+	}
+	/* sonst fehlende Werte: Standard der Fernbedienung */
+	if(r.syncUs <= 0) r.syncUs = CMT_TX_DEF_SYNC;
+	if(r.lowUs <= 0)  r.lowUs  = (r.t0h > 0) ? r.t0h : CMT_TX_DEF_LOW;
+	if(r.highUs <= 0) r.highUs = (r.t1h > 0) ? r.t1h : CMT_TX_DEF_HIGH;
+	if(r.t0h <= 0) r.t0h = r.lowUs;
+	if(r.t0l <= 0) r.t0l = r.highUs;
+	if(r.t1h <= 0) r.t1h = r.highUs;
+	if(r.t1l <= 0) r.t1l = r.lowUs;
+
+	if(r.t0h < 100 || r.t0h > 5000 || r.t0l < 100 || r.t0l > 5000
+		|| r.t1h < 100 || r.t1h > 5000 || r.t1l < 100 || r.t1l > 5000
+		|| r.syncUs < 1000 || r.syncUs > 40000)
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT TX: Zeiten unplausibel (Pulse/Pausen 100..5000 us, Sync 1000..40000 us)");
+		return CMD_RES_BAD_ARGUMENT;
+	}
+	maxRep = (CMT_TX_MAX_ENTRIES - 2) / (2 * r.bits + 2);
+	if(maxRep > CMT_TX_MAX_REPEAT) maxRep = CMT_TX_MAX_REPEAT;
+	if(r.repeat < 1) r.repeat = 1;
+	if(r.repeat > maxRep) r.repeat = maxRep;
+
+	if(s_mode != CMT_MODE_RX)
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT TX: Scan/Spy laeuft (cmtstop)");
+		return CMD_RES_ERROR;
+	}
+	if(!cmt_tx_allowed(s_txKhzNow))
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT TX: Senden auf %u kHz gesperrt (cmtfreq 433.92)", (unsigned)s_txKhzNow);
+		return CMD_RES_ERROR;
+	}
+	if(!cmt_tx_enqueue(&r))
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT TX: Warteschlange voll");
+		return CMD_RES_ERROR;
+	}
+	ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT TX eingereiht: Data=%0*llX Bits=%d Sync=%d T0=%d/%d T1=%d/%d %s Wdh=%d",
+		(r.bits + 3) / 4, (unsigned long long)r.data, r.bits, r.syncUs, r.t0h, r.t0l, r.t1h, r.t1l,
+		r.merged ? "ohne Sync-Puls" : "mit Sync-Puls", r.repeat);
+	return CMD_RES_OK;
+}
+
+static const char *cmt_mod_name(int m)
+{
+	switch(m)
+	{
+	case CMT_MOD_PPM: return "PPM";
+	case CMT_MOD_PWM: return "PWM";
+	case CMT_MOD_PCM: return "PCM";
+	case CMT_MOD_DMC: return "DMC";
+	case CMT_MOD_RCS: return "RCS";
+	}
+	return "?";
+}
+
+static int cmt_mod_parse(const char *s)
+{
+	if(!wal_stricmp(s, "PPM")) return CMT_MOD_PPM;
+	if(!wal_stricmp(s, "PWM")) return CMT_MOD_PWM;
+	if(!wal_stricmp(s, "PCM") || !wal_stricmp(s, "MAN") || !wal_stricmp(s, "NRZ")) return CMT_MOD_PCM;
+	if(!wal_stricmp(s, "DMC")) return CMT_MOD_DMC;
+	if(!wal_stricmp(s, "RCS")) return CMT_MOD_RCS;
+	return 0;
+}
+
+static void cmt_proto_list(void)
+{
+	int i;
+
+	for(i = 0; i < CMT_DEV_MAX; i++)
+	{
+		const cmt_dev_t *d = cmt_dev(i);
+
+		if(!d)
+			continue;
+		ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT %-2d %-11s %-3s %s %4u/%-4u gap %-5u reset %-5u Nachr.=%u Meld.=%u ms=%u/max %u%s  %s",
+			i, d->name, s_devOff[i] ? "AUS" : "an", cmt_mod_name(d->mod), d->s, d->l, d->gapl, d->reset,
+			(unsigned)s_dst[i].msgs, (unsigned)s_dst[i].reports, (unsigned)s_dst[i].sumMs, (unsigned)s_dst[i].maxMs,
+			cmt_stx_find(i) >= 0 ? " [TX cmtsensor]" : "",
+			i >= CMT_D_N ? "eigenes Geraet (cmtflex)" : d->descr);
+	}
+	ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT Pakete=%u (Fenster verschoben %u x; gekuerzt %u, davon %s %u, Meld. daraus %u; Paare/Paket %u) zwischengelagert=%u verworfen(belegt)=%u verteilt=%u ms=%u max=%u ms/Paket Meldungen=%u",
+		(unsigned)s_pkCount, (unsigned)s_pkSlides, (unsigned)s_pkFull, s_pkUseFull ? "ausgewertet" : "uebersprungen",
+		(unsigned)(s_pkUseFull ? s_pkFull - s_pkFullSkip : s_pkFullSkip), (unsigned)s_pkFullRep,
+		(unsigned)(s_pkCount ? s_pkPairs / s_pkCount : 0), (unsigned)s_pkSpared,
+		(unsigned)s_pkDropped, (unsigned)s_pkSplit, (unsigned)s_pkSumMs, (unsigned)s_pkMaxMs, (unsigned)s_recTotal);
+#if CMT_ENABLE_MQTT
+	ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT MQTT: gesendet=%u verloren=%u wartend=%d Byte",
+		(unsigned)s_pqSent, (unsigned)s_pqLost, s_pqW - s_pqR);
+#endif
+	ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT cmtproto <Name|Nr|all> on|off, cmtproto voll on|off, cmtproto reset. Senden mit cmtsendp <Name> <Hex> [Bits] [Wdh]");
+}
+
+static void cmt_proto_reset(void)
+{
+	int i;
+
+	for(i = 0; i < CMT_DEV_MAX; i++)
+		s_dst[i].msgs = s_dst[i].reports = s_dst[i].sumMs = s_dst[i].maxMs = 0;
+	s_pkCount = s_pkDropped = s_pkSplit = s_pkMaxMs = 0;
+	s_pkFull = s_pkPairs = s_pkSumMs = s_pkFullSkip = s_pkFullRep = s_pkSlides = s_pkSpared = 0;
+	s_recTotal = 0;
+#if CMT_ENABLE_MQTT
+	s_pqSent = s_pqLost = 0;
+#endif
+}
+
+/* cmtproto [list] | cmtproto <Name|Nr|all> on|off | cmtproto voll on|off | cmtproto reset */
+static commandResult_t CMD_CmtProto(const void *context, const char *cmd, const char *args, int cmdFlags)
+{
+	const char *a, *v;
+	int i, on;
+
+	Tokenizer_TokenizeString(args, 0);
+	if(Tokenizer_GetArgsCount() == 1 && !wal_stricmp(Tokenizer_GetArg(0), "reset"))
+	{
+		cmt_proto_reset();
+		ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT Zaehler zurueckgesetzt");
+		return CMD_RES_OK;
+	}
+	if(Tokenizer_GetArgsCount() < 2)
+	{
+		cmt_proto_list();
+		return CMD_RES_OK;
+	}
+	a = Tokenizer_GetArg(0);
+	v = Tokenizer_GetArg(1);
+	on = !wal_stricmp(v, "on") || !wal_stricmp(v, "an") || !strcmp(v, "1");
+	if(!on && wal_stricmp(v, "off") && wal_stricmp(v, "aus") && strcmp(v, "0"))
+		return CMD_RES_BAD_ARGUMENT;
+	if(!wal_stricmp(a, "voll") || !wal_stricmp(a, "full"))
+	{
+		s_pkUseFull = on;
+		ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT gekuerzte Pakete (Rauschen davor) werden %s", on ? "ausgewertet" : "uebersprungen");
+		return CMD_RES_OK;
+	}
+	if(!wal_stricmp(a, "all") || !wal_stricmp(a, "alle"))
+	{
+		for(i = 0; i < CMT_DEV_MAX; i++)
+			s_devOff[i] = (uint8_t)!on;
+		ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT alle Protokolle %s", on ? "an" : "aus");
+		return CMD_RES_OK;
+	}
+	i = (a[0] >= '0' && a[0] <= '9') ? atoi(a) : cmt_dev_find(a);
+	if(!cmt_dev(i))
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT Protokoll \"%s\" unbekannt (cmtproto)", a);
+		return CMD_RES_BAD_ARGUMENT;
+	}
+	s_devOff[i] = (uint8_t)!on;
+	ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT Protokoll %s %s", cmt_dev(i)->name, on ? "an" : "aus");
+	return CMD_RES_OK;
+}
+
+/* cmtflex <Name> <PPM|PWM|PCM|DMC|RCS> <kurz> <lang> <gap> <reset> [BitsMin[-BitsMax]] [Wdh] [sync] [Puls]
+ * cmtflex <Name> del | cmtflex list
+ * Eigenes Geraet: meldet passende Zeilen als {"RfProtocol":{"Protocol":"<Name>","Data":...,"Bits":...}} */
+static commandResult_t CMD_CmtFlex(const void *context, const char *cmd, const char *args, int cmdFlags)
+{
+	int argc, i, slot = -1, bmin = 8, bmax = 255, rep = 2;
+	const char *nm, *p;
+	cmt_dev_t *d;
+
+	Tokenizer_TokenizeString(args, 0);
+	argc = Tokenizer_GetArgsCount();
+	if(argc < 1 || !wal_stricmp(Tokenizer_GetArg(0), "list"))
+	{
+		for(i = 0; i < CMT_FLEX_N; i++)
+			if(s_flex[i].used)
+				ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT cmtflex %s %s %u %u %u %u %u-%u %u %u %u",
+					s_flex[i].name, cmt_mod_name(s_flex[i].dev.mod), s_flex[i].dev.s, s_flex[i].dev.l, s_flex[i].dev.gapl,
+					s_flex[i].dev.reset, s_flex[i].bMin, s_flex[i].bMax, s_flex[i].minRep, s_flex[i].dev.sync, s_flex[i].dev.pw);
+		return CMD_RES_OK;
+	}
+	nm = Tokenizer_GetArg(0);
+	for(i = 0; i < CMT_FLEX_N; i++)
+		if(s_flex[i].used && !wal_stricmp(s_flex[i].name, nm))
+			slot = i;
+	if(argc >= 2 && (!wal_stricmp(Tokenizer_GetArg(1), "del") || !wal_stricmp(Tokenizer_GetArg(1), "off")))
+	{
+		if(slot < 0) return CMD_RES_BAD_ARGUMENT;
+		s_flex[slot].used = 0;
+		ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT eigenes Geraet %s geloescht", nm);
+		return CMD_RES_OK;
+	}
+	if(argc < 6)
+		return CMD_RES_NOT_ENOUGH_ARGUMENTS;
+	if(slot < 0)
+	{
+		if(cmt_dev_find(nm) >= 0)
+		{
+			ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT: Name %s ist schon ein eingebautes Protokoll", nm);
+			return CMD_RES_BAD_ARGUMENT;
+		}
+		for(i = 0; i < CMT_FLEX_N && slot < 0; i++)
+			if(!s_flex[i].used)
+				slot = i;
+	}
+	if(slot < 0)
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT: max. %d eigene Geraete", CMT_FLEX_N);
+		return CMD_RES_ERROR;
+	}
+	memset(&s_flex[slot], 0, sizeof(s_flex[slot]));
+	snprintf(s_flex[slot].name, sizeof(s_flex[slot].name), "%s", nm);
+	d = &s_flex[slot].dev;
+	d->name = s_flex[slot].name;
+	d->kind = CMT_K_OTHER;
+	d->mod = (uint8_t)cmt_mod_parse(Tokenizer_GetArg(1));
+	d->s = (uint16_t)atoi(Tokenizer_GetArg(2));
+	d->l = (uint16_t)atoi(Tokenizer_GetArg(3));
+	d->gapl = (uint16_t)atoi(Tokenizer_GetArg(4));
+	d->reset = (uint16_t)atoi(Tokenizer_GetArg(5));
+	if(argc >= 7)
+	{
+		p = Tokenizer_GetArg(6);
+		bmin = atoi(p);
+		bmax = strchr(p, '-') ? atoi(strchr(p, '-') + 1) : bmin;
+	}
+	if(argc >= 8) rep = atoi(Tokenizer_GetArg(7));
+	if(argc >= 9) d->sync = (uint16_t)atoi(Tokenizer_GetArg(8));
+	if(argc >= 10) d->pw = (uint16_t)atoi(Tokenizer_GetArg(9));
+	if(!d->mod || d->s < 50 || d->l < d->s || d->reset < d->l || bmin < 1 || bmax < bmin)
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT cmtflex: <Name> <PPM|PWM|PCM|DMC|RCS> <kurz> <lang> <gap> <reset> [BitsMin-BitsMax] [Wdh] [sync] [Puls]");
+		return CMD_RES_BAD_ARGUMENT;
+	}
+	d->txgap = d->gapl ? (uint16_t)(d->gapl + d->l) : (uint16_t)(d->reset + 1000);
+	d->txrep = 5;
+	d->dec = cmt_d_flex;
+	d->descr = "";
+	s_flex[slot].bMin = (uint8_t)(bmin > 255 ? 255 : bmin);
+	s_flex[slot].bMax = (uint8_t)(bmax > 255 ? 255 : bmax);
+	s_flex[slot].minRep = (uint8_t)(rep < 1 ? 1 : rep);
+	s_flex[slot].used = 1;
+	s_devOff[CMT_D_N + slot] = 0;
+	memset(&s_dst[CMT_D_N + slot], 0, sizeof(s_dst[0]));
+	ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT eigenes Geraet %s: %s %u/%u gap %u reset %u, %d..%d Bit, %d Wdh",
+		d->name, cmt_mod_name(d->mod), d->s, d->l, d->gapl, d->reset, bmin, bmax, s_flex[slot].minRep);
+	return CMD_RES_OK;
+}
+
+static int cmt_tx_check(void)
+{
+	if(!s_chipOk || !s_rxRunning)
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT TX: Empfaenger/Timer laeuft nicht");
+		return 0;
+	}
+	if(s_mode != CMT_MODE_RX)
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT TX: Scan/Spy/Spektrum laeuft (cmtstop)");
+		return 0;
+	}
+	if(!cmt_tx_allowed(s_txKhzNow))
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT TX: Senden auf %u kHz gesperrt", (unsigned)s_txKhzNow);
+		return 0;
+	}
+	return 1;
+}
+
+/* cmtsendp <Protokoll> <HexDaten> [Bits] [Wdh]  Rohdaten mit dem Timing eines Protokolls senden
+ * (z.B. Data/Bits aus einer RfProtocol-Meldung oder einem cmtflex-Geraet) */
+static commandResult_t CMD_CmtSendP(const void *context, const char *cmd, const char *args, int cmdFlags)
+{
+	cmt_txreq_t r;
+	const char *hx;
+	int argc, nb, i, dev;
+	uint8_t b[sizeof(r.row[0])];
+
+	Tokenizer_TokenizeString(args, 0);
+	argc = Tokenizer_GetArgsCount();
+	if(argc < 2)
+		return CMD_RES_NOT_ENOUGH_ARGUMENTS;
+	dev = cmt_dev_find(Tokenizer_GetArg(0));
+	if(dev < 0)
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT TX: Protokoll %s unbekannt (cmtproto)", Tokenizer_GetArg(0));
+		return CMD_RES_BAD_ARGUMENT;
+	}
+	hx = Tokenizer_GetArg(1);
+	if(hx[0] == '0' && (hx[1] == 'x' || hx[1] == 'X'))
+		hx += 2;
+	memset(b, 0, sizeof(b));
+	for(i = 0; hx[i] && i < (int)sizeof(b) * 2; i++)
+	{
+		int v = (hx[i] >= '0' && hx[i] <= '9') ? hx[i] - '0' : ((hx[i] | 0x20) >= 'a' && (hx[i] | 0x20) <= 'f') ? (hx[i] | 0x20) - 'a' + 10 : -1;
+
+		if(v < 0)
+			return CMD_RES_BAD_ARGUMENT;
+		b[i >> 1] |= (uint8_t)(v << ((i & 1) ? 0 : 4));
+	}
+	nb = argc >= 3 ? atoi(Tokenizer_GetArg(2)) : i * 4;
+	if(nb < 1 || nb > i * 4)
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT TX: Bits muss 1..%d sein", i * 4);
+		return CMD_RES_BAD_ARGUMENT;
+	}
+	if(!cmt_tx_check())
+		return CMD_RES_ERROR;
+	memset(&r, 0, sizeof(r));
+	r.gen = 1;
+	r.dev = dev;
+	cmt_txrow_set(&r, 0, b, nb);
+	r.repeat = argc >= 4 ? atoi(Tokenizer_GetArg(3)) : (cmt_dev(dev)->txrep ? cmt_dev(dev)->txrep : 5);
+	if(r.repeat < 1) r.repeat = 1;
+	if(r.repeat > 30) r.repeat = 30;
+	if(!cmt_tx_enqueue(&r))
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT TX: Warteschlange voll");
+		return CMD_RES_ERROR;
+	}
+	ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT TX eingereiht: %s Data=%s Bits=%d Wdh=%d", cmt_dev(dev)->name, Tokenizer_GetArg(1), nb, r.repeat);
+	return CMD_RES_OK;
+}
+
+/* cmtkaku <Id_hex(26 Bit)> <Einheit 1..16> <on|off|0..15> [Gruppe 0/1]
+ * Intertechno selbstlernend / KlikAanKlikUit / Nexa: Zahl = Dimmstufe */
+static commandResult_t CMD_CmtKaku(const void *context, const char *cmd, const char *args, int cmdFlags)
+{
+	cmt_txreq_t r;
+	uint32_t id;
+	int unit, c, dim = 0, group = 0;
+	const char *a;
+
+	Tokenizer_TokenizeString(args, 0);
+	if(Tokenizer_GetArgsCount() < 3)
+		return CMD_RES_NOT_ENOUGH_ARGUMENTS;
+	id = (uint32_t)cmt_parse_hex(Tokenizer_GetArg(0)) & 0x3FFFFFF;
+	unit = atoi(Tokenizer_GetArg(1));
+	a = Tokenizer_GetArg(2);
+	if(!wal_stricmp(a, "on") || !wal_stricmp(a, "an")) c = 1;
+	else if(!wal_stricmp(a, "off") || !wal_stricmp(a, "aus")) c = 0;
+	else { c = 2; dim = atoi(a); }
+	if(Tokenizer_GetArgsCount() >= 4) group = atoi(Tokenizer_GetArg(3));
+	if(unit < 1 || unit > 16 || dim < 0 || dim > 15)
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT: cmtkaku <Id_hex> <Einheit 1..16> <on|off|0..15> [Gruppe]");
+		return CMD_RES_BAD_ARGUMENT;
+	}
+	if(!cmt_tx_check())
+		return CMD_RES_ERROR;
+	memset(&r, 0, sizeof(r));
+	r.gen = 1;
+	r.dev = CMT_D_NEWKAKU;
+	r.repeat = s_dev[CMT_D_NEWKAKU].txrep;
+	cmt_kaku_bits(id, group, c, unit, dim, &r);
+	if(!cmt_tx_enqueue(&r))
+		return CMD_RES_ERROR;
+	ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT TX Intertechno Id=%07X Einheit=%d %s%s", (unsigned)id, unit,
+		c == 1 ? "An" : (c == 0 ? "Aus" : "Dimmen"), group ? " (Gruppe)" : "");
+	return CMD_RES_OK;
+}
+
+static void cmt_sens_list_protocols(void)
+{
+	int p;
+
+	for(p = 0; p < CMT_STX_N; p++)
+	{
+		const cmt_dev_t *d = &s_dev[s_stx[p].dev];
+		char chs[16], lo[12], hi[12];
+
+		if(s_stx[p].maxCh)
+			snprintf(chs, sizeof(chs), "Kanal 1..%d", s_stx[p].maxCh);
+		else
+			snprintf(chs, sizeof(chs), "ohne Kanal");
+		cmt_fmt_tenth(lo, sizeof(lo), s_stx[p].tMin);
+		cmt_fmt_tenth(hi, sizeof(hi), s_stx[p].tMax);
+		ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT Sensor-TX %-11s %s, %s..%s C%s, %s", d->name, chs, lo, hi,
+			s_stx[p].hasHum ? ", Feuchte" : "", d->descr);
+	}
+	ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT Empfang: alle Protokolle mit cmtproto anzeigen");
+}
+
+/* cmtsensor <Kanal> <Temp> [Feuchte] [Id] [Batterie] [Intervall_s] [Protokoll]
+ * cmtsensor <Kanal> off | cmtsensor <Kanal> <Protokoll> | cmtsensor protocols | JSON
+ * Der Protokollname darf an beliebiger Stelle stehen, die Zahlen bleiben in ihrer Reihenfolge. */
+static commandResult_t CMD_CmtSensor(const void *context, const char *cmd, const char *args, int cmdFlags)
+{
+	int ch = 0, hum = -1, id = -1, bat = -1, interval = -1, haveTemp = 0, off = 0, dev = -1, tenth = 0, i, p;
+	double temp = 0.0;
+	const char *a;
+	char t[12];
+	const cmt_stx_t *sx;
+
+	if(!s_chipOk) return CMD_RES_ERROR;
+	if(args && strchr(args, '{'))
+	{
+		if((a = cmt_json_find(args, "Channel")))     ch = atoi(a);
+		if((a = cmt_json_find(args, "Temperature"))) { temp = atof(a); haveTemp = 1; }
+		if((a = cmt_json_find(args, "Humidity")))    hum = atoi(a);
+		if((a = cmt_json_find(args, "Id")))          id = (int)cmt_parse_hex(a);
+		if((a = cmt_json_find(args, "Battery")))     bat = atoi(a);
+		if((a = cmt_json_find(args, "Interval")))    interval = atoi(a);
+		if((a = cmt_json_find(args, "Off")))         off = atoi(a);
+		if((a = cmt_json_find(args, "Protocol")))
+		{
+			char nm[16];
+			int k = 0;
+
+			while(a[k] && a[k] != '"' && a[k] != ',' && a[k] != '}' && a[k] != ' ' && k < (int)sizeof(nm) - 1)
+			{
+				nm[k] = a[k];
+				k++;
+			}
+			nm[k] = 0;
+			dev = cmt_dev_find(nm);
+			if(dev < 0)
+			{
+				ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT Sensor: Protokoll \"%s\" unbekannt (cmtsensor protocols)", nm);
+				return CMD_RES_BAD_ARGUMENT;
+			}
+		}
+	}
+	else
+	{
+		const char *num[6];
+		int argc, nnum = 0;
+
+		Tokenizer_TokenizeString(args, 0);
+		argc = Tokenizer_GetArgsCount();
+		if(argc >= 1 && (!wal_stricmp(Tokenizer_GetArg(0), "protocols") || !wal_stricmp(Tokenizer_GetArg(0), "protokolle")
+			|| !wal_stricmp(Tokenizer_GetArg(0), "list")))
+		{
+			cmt_sens_list_protocols();
+			return CMD_RES_OK;
+		}
+		for(i = 0; i < argc; i++)
+		{
+			a = Tokenizer_GetArg(i);
+			if(i > 0 && (!wal_stricmp(a, "off") || !wal_stricmp(a, "aus")))
+				off = 1;
+			else if(i > 0 && (p = cmt_dev_find(a)) >= 0)
+				dev = p;
+			else if(nnum < 6)
+				num[nnum++] = a;
+		}
+		if(nnum < 1)
+			return CMD_RES_NOT_ENOUGH_ARGUMENTS;
+		ch = atoi(num[0]);
+		if(nnum >= 2) { temp = atof(num[1]); haveTemp = 1; }
+		if(nnum >= 3) hum = atoi(num[2]);
+		if(nnum >= 4) id = (int)cmt_parse_hex(num[3]);
+		if(nnum >= 5) bat = atoi(num[4]);
+		if(nnum >= 6) interval = atoi(num[5]);
+	}
+	if(ch < 1 || ch > CMT_VS_SLOTS)
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT Sensor: Kanal muss 1..%d sein", CMT_VS_SLOTS);
+		return CMD_RES_BAD_ARGUMENT;
+	}
+	i = ch - 1;
+	if(off)
+	{
+		s_vs[i].active = 0;
+		ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT Sensor Kanal %d abgeschaltet", ch);
+		return CMD_RES_OK;
+	}
+	if(dev < 0)
+		dev = s_vs[i].active ? s_vs[i].dev : CMT_D_NEXUS;
+	p = cmt_stx_find(dev);
+	if(p < 0)
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT Sensor: %s kann cmtsensor nicht senden (cmtsensor protocols; Rohdaten: cmtsendp)", cmt_dev(dev)->name);
+		return CMD_RES_BAD_ARGUMENT;
+	}
+	sx = &s_stx[p];
+	if(sx->maxCh && ch > sx->maxCh)
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT Sensor: Protokoll %s kennt nur Kanal 1..%d (Kanal 1..8: F007TH, ohne Kanal: LaCrosseTX, WH2)",
+			s_dev[dev].name, sx->maxCh);
+		return CMD_RES_BAD_ARGUMENT;
+	}
+	/* nur Protokoll wechseln: vorhandene Werte behalten */
+	if(!haveTemp && s_vs[i].active)
+	{
+		haveTemp = 1;
+		tenth = s_vs[i].tenth;
+		if(hum < 0) hum = s_vs[i].hum;
+	}
+	else
+		tenth = (int)(temp * 10.0 + (temp >= 0.0 ? 0.5 : -0.5));
+	if(!sx->hasHum)
+		hum = 0;
+	if(!haveTemp || tenth < sx->tMin || tenth > sx->tMax || hum < 0 || hum > 100)
+	{
+		char lo[12], hi[12];
+
+		cmt_fmt_tenth(lo, sizeof(lo), sx->tMin);
+		cmt_fmt_tenth(hi, sizeof(hi), sx->tMax);
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT Sensor: %s braucht Temperatur %s..%s C%s", s_dev[dev].name, lo, hi,
+			sx->hasHum ? " und Feuchte 0..100 %" : "");
+		return CMD_RES_BAD_ARGUMENT;
+	}
+	if(!s_vs[i].active)
+	{
+		/* neuer Kanal: Standardwerte, solange nichts angegeben ist */
+		if(id < 0) id = (s_vs[i].id > 0) ? s_vs[i].id : CMT_VS_DEF_ID;
+		if(bat < 0) bat = 1;
+		if(interval < 0) interval = CMT_VS_DEF_INTERVAL;
+	}
+	if(id >= 0) s_vs[i].id = id;
+	if(bat >= 0) s_vs[i].bat = bat ? 1 : 0;
+	if(interval >= 0) s_vs[i].interval = interval > 3600 ? 3600 : interval;
+	s_vs[i].id &= sx->idMask;
+	s_vs[i].dev = dev;
+	s_vs[i].tenth = tenth;
+	s_vs[i].hum = sx->hasHum ? hum : -1;
+	s_vs[i].active = 1;
+
+	cmt_fmt_tenth(t, sizeof(t), tenth);
+	if(s_rxRunning && s_mode == CMT_MODE_RX && cmt_vs_send(ch))
+	{
+		s_vs[i].lastMs = rtos_get_time();
+		ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT Sensor Kanal %d: %s Id=%02X Temp=%s Feuchte=%d Batterie=%d Intervall=%d s - wird gesendet",
+			ch, s_dev[dev].name, s_vs[i].id, t, s_vs[i].hum, s_vs[i].bat, s_vs[i].interval);
+	}
+	else
+	{
+		/* gerade belegt (Scan/Spy/Warteschlange): beim naechsten Tick nachholen */
+		s_vs[i].lastMs = rtos_get_time() - (uint32_t)s_vs[i].interval * 1000u;
+		ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT Sensor Kanal %d gespeichert (%s Id=%02X Temp=%s Feuchte=%d), Senden %s",
+			ch, s_dev[dev].name, s_vs[i].id, t, s_vs[i].hum, s_vs[i].interval > 0 ? "folgt" : "nicht moeglich (Sender belegt, Intervall 0)");
+	}
+	return CMD_RES_OK;
+}
+
+/* cmtvco [min_MHz max_MHz]  VCO-Bereich anzeigen/setzen, abstimmbare Baender listen */
+static commandResult_t CMD_CmtVco(const void *context, const char *cmd, const char *args, int cmdFlags)
+{
+	int c;
+
+	Tokenizer_TokenizeString(args, 0);
+	if(Tokenizer_GetArgsCount() >= 2)
+	{
+		uint32_t mn = (uint32_t)(atof(Tokenizer_GetArg(0)) * 1000.0 + 0.5);
+		uint32_t mx = (uint32_t)(atof(Tokenizer_GetArg(1)) * 1000.0 + 0.5);
+
+		if(mn < 1000000 || mx > 3000000 || mn >= mx)
+		{
+			ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT: VCO-Bereich muss zwischen 1000 und 3000 MHz liegen (min < max)");
+			return CMD_RES_BAD_ARGUMENT;
+		}
+		s_vcoMinKhz = mn;
+		s_vcoMaxKhz = mx;
+	}
+	ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT VCO %u..%u MHz (Teiler = (Code+1)*2, nur Code 1 an Hardware geprueft)",
+		(unsigned)(s_vcoMinKhz / 1000), (unsigned)(s_vcoMaxKhz / 1000));
+	for(c = 7; c >= 0; c--)
+	{
+		uint32_t div = (uint32_t)((c + 1) * 2);
+		ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT Band Code %d (Teiler %2u): %4u.%03u .. %4u.%03u MHz", c, (unsigned)div,
+			(unsigned)(s_vcoMinKhz / div / 1000), (unsigned)(s_vcoMinKhz / div % 1000),
+			(unsigned)(s_vcoMaxKhz / div / 1000), (unsigned)(s_vcoMaxKhz / div % 1000));
+	}
+	return CMD_RES_OK;
+}
+
+/* cmtspec [von bis [kHz [MQTT_s [schnell]]]] | cmtspec off | reset | clear */
+static commandResult_t CMD_CmtSpec(const void *context, const char *cmd, const char *args, int cmdFlags)
+{
+	uint32_t from = 433000, to = 434800, step = 25;
+	int pub = 5, fast = 0, argc, n;
+	const char *a0;
+
+	if(!s_chipOk) return CMD_RES_ERROR;
+	Tokenizer_TokenizeString(args, 0);
+	argc = Tokenizer_GetArgsCount();
+	a0 = argc >= 1 ? Tokenizer_GetArg(0) : "";
+	if(!strcmp(a0, "off") || !strcmp(a0, "aus"))
+	{
+		cmt_spec_stop("angehalten");
+		return CMD_RES_OK;
+	}
+	if(!strcmp(a0, "reset"))
+	{
+		if(s_spec)
+		{
+			memset(s_spec->hold, 0, sizeof(s_spec->hold));
+			memset(s_spec->win, 0, sizeof(s_spec->win));
+			s_spec->sweeps = 0;
+			s_spec->pubSweeps = 0;
+		}
+		ADDLOG_INFO(LOG_FEATURE_MAIN, "CMTSPEC Max-Hold und Mittel geloescht");
+		return CMD_RES_OK;
+	}
+	if(!strcmp(a0, "clear"))
+	{
+		cmt_spec_stop("angehalten");
+		if(s_spec)
+			free(s_spec);
+		s_spec = NULL;
+		ADDLOG_INFO(LOG_FEATURE_MAIN, "CMTSPEC Daten freigegeben");
+		return CMD_RES_OK;
+	}
+	if(argc >= 1) from = (uint32_t)(atof(Tokenizer_GetArg(0)) * 1000.0 + 0.5);
+	if(argc >= 2) to = (uint32_t)(atof(Tokenizer_GetArg(1)) * 1000.0 + 0.5);
+	else if(argc == 1) to = from + 1800;
+	if(argc >= 3) step = (uint32_t)atoi(Tokenizer_GetArg(2));
+	if(argc >= 4) pub = atoi(Tokenizer_GetArg(3));
+	if(argc >= 5) fast = atoi(Tokenizer_GetArg(4));
+	n = cmt_spec_start(from, to, step, pub, fast);
+	if(n == -1) { ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMTSPEC: beschaeftigt (cmtstop / Senden laeuft)"); return CMD_RES_ERROR; }
+	if(n == -2) { ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMTSPEC: Bereich ungueltig (100..1100 MHz)"); return CMD_RES_BAD_ARGUMENT; }
+	if(n < 0)   { ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMTSPEC: kein Speicher (%d Bytes)", (int)sizeof(cmt_spec_t)); return CMD_RES_ERROR; }
+	ADDLOG_INFO(LOG_FEATURE_MAIN, "CMTSPEC gestartet: %u..%u kHz, Schritt %u kHz, %d Punkte, MQTT alle %d s, %s - Empfang ruht (cmtspec off)",
+		(unsigned)s_spec->from, (unsigned)(s_spec->from + (uint32_t)(n - 1) * s_spec->step), (unsigned)s_spec->step, n,
+		s_spec->pubSec, s_spec->fast ? "schnell" : "mit Sleep");
+	return CMD_RES_OK;
+}
+
+/* cmtcarrier [ms]  Testtraeger (fuer SDR/Leistungsmessung), Standard 1000 ms */
+static commandResult_t CMD_CmtCarrier(const void *context, const char *cmd, const char *args, int cmdFlags)
+{
+	cmt_txreq_t r;
+	int ms = 1000;
+
+	if(!s_chipOk || !s_rxRunning || s_mode != CMT_MODE_RX) return CMD_RES_ERROR;
+	Tokenizer_TokenizeString(args, 0);
+	if(Tokenizer_GetArgsCount() >= 1)
+		ms = Tokenizer_GetArgInteger(0);
+	if(ms < 10) ms = 10;
+	if(ms > 3000) ms = 3000;
+	memset(&r, 0, sizeof(r));
+	r.carrierMs = ms;
+	if(!cmt_tx_allowed(s_txKhzNow))
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT TX: Senden auf %u kHz gesperrt (cmtfreq 433.92)", (unsigned)s_txKhzNow);
+		return CMD_RES_ERROR;
+	}
+	if(!cmt_tx_enqueue(&r))
+	{
+		ADDLOG_ERROR(LOG_FEATURE_MAIN, "CMT TX: Warteschlange voll");
+		return CMD_RES_ERROR;
+	}
+	ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT TX Traeger eingereiht: %d ms auf %u kHz", ms, (unsigned)cmt_cur_khz(1));
+	return CMD_RES_OK;
+}
