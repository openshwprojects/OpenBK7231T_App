+static void cmt_dump_regs(void)
+{
+	char buf[128];
+	int a, p;
+
+	for(a = 0; a <= 0x6F; a += 8)
+	{
+		p = snprintf(buf, sizeof(buf), "%02X:", a);
+		for(int k = 0; k < 8 && (a + k) <= 0x6F; k++)
+			p += snprintf(buf + p, sizeof(buf) - p, " %02X", CMT2300A_ReadReg((BYTE)(a + k)));
+		ADDLOG_INFO(LOG_FEATURE_MAIN, "%s", buf);
+	}
+}
