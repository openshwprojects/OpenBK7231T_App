+/* ---- Ausgabe ---- */
+static int cmt_rec_fmt(const cmt_rec_t *r, char *buf, int sz, int json)
+{
+	const cmt_dev_t *d = cmt_dev(r->dev);
+	int p, i;
+
+	if(json)
+		p = snprintf(buf, sz, "{\"%s\":{\"Protocol\":\"%s\"", d->kind == CMT_K_SENSOR ? "RfSensor" : "RfProtocol", d->name);
+	else
+		p = snprintf(buf, sz, "%s", d->name);
+	for(i = 0; i < r->n && p < sz - 1; i++)
+	{
+		const cmt_fld_t *f = &r->f[i];
+		char v[24];
+
+		switch(f->t)
+		{
+		case CMT_F_TENTH: cmt_fmt_tenth(v, sizeof(v), f->v); break;
+		case CMT_F_HEX:   snprintf(v, sizeof(v), json ? "\"%0*X\"" : "%0*X", f->w, (unsigned)f->v); break;
+		case CMT_F_STR:   snprintf(v, sizeof(v), json ? "\"%s\"" : "%s", f->s ? f->s : ""); break;
+		default:          snprintf(v, sizeof(v), "%d", (int)f->v); break;
+		}
+		p += snprintf(buf + p, sz - p, json ? ",\"%s\":%s" : " %s=%s", f->k, v);
+	}
+	if(r->bits > 0 && p < sz - 1)
+		p += snprintf(buf + p, sz - p, json ? ",\"Data\":\"%s\",\"Bits\":%d" : " Data=%s Bits=%d", r->data, r->bits);
+	if(json && p < sz - 1)
+		p += snprintf(buf + p, sz - p, "}}");
+	if(p >= sz) p = sz - 1;
+	return p;
+}
