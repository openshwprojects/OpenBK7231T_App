+/* LaCrosse TX3/TX4/TX7: 0 A Typ ID(7)+Paritaet Wert(3x BCD) Wiederholung(2x BCD) Summe(4) */
+static int cmt_d_lacrosse(int d, cmt_bb_t *bb)
+{
+	int r, i, n[11], sum, v;
+	cmt_rec_t *const op = &s_rec;
+
+	for(r = 0; r < bb->nrows; r++)
+	{
+		uint8_t b[6];
+
+		if(bb->bits[r] != 44)
+			continue;
+		bb_bytes(bb, r, 0, b, 6);
+		for(i = 0; i < 11; i++)
+			n[i] = (b[i >> 1] >> ((i & 1) ? 0 : 4)) & 0xF;
+		if(n[0] != 0 || n[1] != 0xA)
+			continue;
+		for(sum = 0, i = 0; i < 10; i++)
+			sum += n[i];
+		if((sum & 0xF) != n[10] || n[8] != n[5] || n[9] != n[6] || n[5] > 9 || n[6] > 9 || n[7] > 9)
+			continue;
+		if(((cmt_popc4(n[5]) + cmt_popc4(n[6]) + cmt_popc4(n[7]) + (n[4] & 1)) & 1) != 0)
+			continue;
+		v = n[5] * 100 + n[6] * 10 + n[7];
+		rec_init(op, d);
+		rec_hex(op, "Id", (uint32_t)((n[3] << 3) | (n[4] >> 1)), 2);
+		if(n[2] == 0x0)
+			rec_tenth(op, "Temperature", v - 500);
+		else if(n[2] == 0xE && v / 10 <= 100)
+			rec_int(op, "Humidity", v / 10);
+		else
+			continue;
+		return cmt_emit(op);
+	}
+	return 0;
+}
