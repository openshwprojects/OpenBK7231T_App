+static const cmt_dev_t *cmt_dev(int i)
+{
+	if(i >= 0 && i < CMT_D_N) return &s_dev[i];
+	if(i >= CMT_D_N && i < CMT_DEV_MAX && s_flex[i - CMT_D_N].used) return &s_flex[i - CMT_D_N].dev;
+	return NULL;
+}
+
+static int cmt_dev_find(const char *name)
+{
+	int i;
+
+	for(i = 0; i < CMT_DEV_MAX; i++)
+	{
+		const cmt_dev_t *d = cmt_dev(i);
+
+		if(d && !wal_stricmp(name, d->name))
+			return i;
+	}
+	return -1;
+}
