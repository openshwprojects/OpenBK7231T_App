+/* WT450: 1100 Haus(4) Kanal-1(2) xx BattLow(1) Feuchte(7) Temp(8, +50 C) Temp/16(4) Folge(2) Paritaet(2) */
+static int cmt_d_wt450(int d, cmt_bb_t *bb)
+{
+	int r, hum, s16;
+	uint8_t b[5], x;
+	cmt_rec_t *const op = &s_rec;
+
+	for(r = 0; r < bb->nrows; r++)
+	{
+		if(bb->bits[r] != 36)
+			continue;
+		bb_bytes(bb, r, 0, b, 5);
+		if((b[0] >> 4) != 0xC)
+			continue;
+		x = (uint8_t)(b[0] ^ b[1] ^ b[2] ^ b[3] ^ b[4]);
+		x ^= x >> 4;
+		x ^= x >> 2;
+		if(x & 3)
+			continue;
+		hum = ((b[1] & 7) << 4) | (b[2] >> 4);
+		s16 = ((((b[2] & 0x0F) << 4) | (b[3] >> 4)) - 50) * 16 + (b[3] & 0x0F);
+		if(hum > 100 || s16 < -35 * 16 || s16 > 75 * 16)
+			continue;
+		rec_init(op, d);
+		rec_sensor(op, b[0] & 0x0F, 1, (b[1] >> 6) + 1, (b[1] & 0x08) ? 0 : 1);
+		rec_tenth(op, "Temperature", (s16 * 10 + (s16 >= 0 ? 8 : -8)) / 16);
+		rec_int(op, "Humidity", hum);
+		return cmt_emit(op);
+	}
+	return 0;
+}
