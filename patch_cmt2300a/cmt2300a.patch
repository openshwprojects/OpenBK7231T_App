+/* Fine Offset WH2: FF Typ(4)=4 ID(8) Temp(12, Vorzeichen+Betrag) Feuchte(8) CRC-8(0x31, 0) */
+static int cmt_d_wh2(int d, cmt_bb_t *bb)
+{
+	int r, t;
+	uint8_t b[6];
+	cmt_rec_t *const op = &s_rec;
+
+	for(r = 0; r < bb->nrows; r++)
+	{
+		int st, found = 0;
+
+		/* WH2 hat weder Sync noch Vorspann: Rauschen ohne Pause davor haengt Bits vorne an die
+		 * Zeile. Telegramm deshalb vom Zeilenende her suchen (FF, Typ 4, CRC). */
+		if(bb->bits[r] < 48 || bb->bits[r] > 200)
+			continue;
+		for(st = bb->bits[r] - 48; st >= 0 && !found; st--)
+		{
+			if(!bb_get(bb, r, st) || !bb_get(bb, r, st + 7))
+				continue;                        /* schneller Vorfilter: FF beginnt und endet mit 1 */
+			bb_bytes(bb, r, st, b, 6);
+			found = b[0] == 0xFF && (b[1] >> 4) == 4 && cmt_crc8(b + 1, 4, 0x31, 0) == b[5];
+		}
+		if(!found)
+			continue;
+		t = ((b[2] & 0x0F) << 8) | b[3];
+		if(t & 0x800) t = -(t & 0x7FF);
+		rec_init(op, d);
+		rec_hex(op, "Id", (uint32_t)(((b[1] & 0x0F) << 4) | (b[2] >> 4)), 2);
+		rec_tenth(op, "Temperature", t);
+		if(b[4] != 0xFF) rec_int(op, "Humidity", b[4]);
+		return cmt_emit(op);
+	}
+	return 0;
+}
