+/* ====================================================================
+ *  Protokoll-Engine (Aufbau wie rtl_433)
+ *  1. Paketsammler: Puls/Pause-Paare, Paketende bei Pause >= CMT_PK_END,
+ *     Funkstille > 40 ms oder vollem Puffer.
+ *  2. Fuer jedes eingeschaltete Geraet (s_dev[] + eigene cmtflex-Geraete)
+ *     zerlegt ein Slicer das Paket mit dessen Zeiten in Bitzeilen:
+ *       PPM  Bit aus der Pause    (kurz = 0, lang = 1)
+ *       PWM  Bit aus dem Puls     (kurz = 1, lang = 0)
+ *       PCM  Puls/Pause -> Anzahl Bitzeiten 1/0 (fuer Manchester-Decoder)
+ *       DMC  differentielles Manchester (volle Zelle = 0, zwei halbe = 1)
+ *       RCS  rc-switch streng: Puls + Pause muessen eine Periode ergeben (lang = 1)
+ *     Pause > gapl: neue Zeile, Pause > reset: Nachricht zu Ende -> Decoder.
+ *  3. Der Decoder prueft (Pruefsumme, feste Bits, Wiederholungen) und meldet
+ *     einen Datensatz (cmt_emit): MQTT, Verlauf auf der Hauptseite, Spy.
+ *  Bitkonventionen und Formate wie rtl_433 (src/devices/...), damit Decoder
+ *  von dort leicht uebernommen werden koennen.
+ *  Nur OOK/ASK: FSK-Sensoren (viele 868-MHz-Geraete, Bresser 5in1/6in1,
+ *  LaCrosse IT+ TX29/TX35) brauchen eine andere Chip-Konfiguration.
+ * ==================================================================== */
+#define CMT_MOD_PPM  1
+#define CMT_MOD_PWM  2
+#define CMT_MOD_PCM  3
+#define CMT_MOD_DMC  4
+#define CMT_MOD_RCS  5
+
+#define CMT_K_SENSOR 0
+#define CMT_K_REMOTE 1
+#define CMT_K_OTHER  2
+
+#define CMT_SENS_REPORT_MS   3000     /* Sensor: gleiche Meldung frueher nicht nochmal */
+#define CMT_REMOTE_REPORT_MS 700      /* Fernbedienung/Sonstiges */
+
+static void cmt_fmt_tenth(char *buf, int sz, int tenth)
+{
+	int a = tenth < 0 ? -tenth : tenth;
+
+	snprintf(buf, sz, "%s%d.%d", tenth < 0 ? "-" : "", a / 10, a % 10);
+}
+
+/* 0,1 C <-> 0,1 F (gerundet) */
+static int cmt_c2f(int tc) { return (tc * 9 + (tc >= 0 ? 2 : -2)) / 5 + 320; }
+static int cmt_f2c(int tf) { int d = (tf - 320) * 5; return (d + (d >= 0 ? 4 : -4)) / 9; }
+static int cmt_s12(int v) { v &= 0xFFF; return (v & 0x800) ? v - 0x1000 : v; }
+
+/* ---- Pruefsummen (wie rtl_433 bit_util.c) ---- */
+static uint8_t cmt_crc8(const uint8_t *m, int n, uint8_t poly, uint8_t init)
+{
+	uint8_t r = init;
+	int i, b;
+
+	for(i = 0; i < n; i++)
+	{
+		r ^= m[i];
+		for(b = 0; b < 8; b++)
+			r = (r & 0x80) ? (uint8_t)((r << 1) ^ poly) : (uint8_t)(r << 1);
+	}
+	return r;
+}
+
+static uint8_t cmt_crc4(const uint8_t *m, int n, uint8_t poly, uint8_t init)
+{
+	uint8_t r = (uint8_t)(init << 4), p = (uint8_t)(poly << 4);
+	int i, b;
+
+	for(i = 0; i < n; i++)
+	{
+		r ^= m[i];
+		for(b = 0; b < 8; b++)
+			r = (r & 0x80) ? (uint8_t)((r << 1) ^ p) : (uint8_t)(r << 1);
+	}
+	return (uint8_t)((r >> 4) & 0x0F);
+}
+
+static uint8_t cmt_lfsr8(const uint8_t *m, int n, uint8_t gen, uint8_t key)
+{
+	uint8_t sum = 0;
+	int k, i;
+
+	for(k = 0; k < n; k++)
+		for(i = 7; i >= 0; i--)
+		{
+			if((m[k] >> i) & 1)
+				sum ^= key;
+			key = (key & 1) ? (uint8_t)((key >> 1) ^ gen) : (uint8_t)(key >> 1);
+		}
+	return sum;
+}
+
+static uint8_t cmt_lfsr8_reflect(const uint8_t *m, int n, uint8_t gen, uint8_t key)
+{
+	uint8_t sum = 0;
+	int k, i;
+
+	for(k = n - 1; k >= 0; k--)
+		for(i = 0; i < 8; i++)
+		{
+			if((m[k] >> i) & 1)
+				sum ^= key;
+			key = (key & 0x80) ? (uint8_t)((key << 1) ^ gen) : (uint8_t)(key << 1);
+		}
+	return sum;
+}
+
+static int cmt_popc4(int v) { return (v & 1) + ((v >> 1) & 1) + ((v >> 2) & 1) + ((v >> 3) & 1); }
+static int cmt_par8(uint8_t v) { v ^= v >> 4; v ^= v >> 2; v ^= v >> 1; return v & 1; }
+
+/* ---- Bitpuffer (Zeilen wie rtl_433, leere Zeilen werden nicht angelegt) ---- */
+#define CMT_BB_ROWS 16
+#define CMT_BB_BITS 512
+
+typedef struct
+{
+	int nrows, full;
+	uint16_t bits[CMT_BB_ROWS];
+	uint8_t syncs[CMT_BB_ROWS];
+	uint8_t b[CMT_BB_ROWS][CMT_BB_BITS / 8];
+} cmt_bb_t;
+
+static cmt_bb_t s_bb;
+
+static void bb_clear(cmt_bb_t *bb)
+{
+	bb->nrows = 0;
+	bb->full = 0;
+	bb->bits[0] = 0;
+	bb->syncs[0] = 0;
+}
+
+static void bb_row(cmt_bb_t *bb)
+{
+	if(bb->nrows == 0)
+	{
+		bb->nrows = 1;
+		bb->bits[0] = 0;
+		bb->syncs[0] = 0;
+		return;
+	}
+	if(bb->bits[bb->nrows - 1] == 0)
+		return;
+	if(bb->nrows >= CMT_BB_ROWS)
+	{
+		bb->full = 1;
+		return;
+	}
+	bb->bits[bb->nrows] = 0;
+	bb->syncs[bb->nrows] = 0;
+	bb->nrows++;
+}
+
+static void bb_sync(cmt_bb_t *bb)
+{
+	bb_row(bb);
+	if(!bb->full && bb->syncs[bb->nrows - 1] < 255)
+		bb->syncs[bb->nrows - 1]++;
+}
+
+static inline __attribute__((always_inline)) void bb_bit(cmt_bb_t *bb, int v)
+{
+	int r, n;
+
+	if(bb->nrows == 0)
+		bb_row(bb);
+	if(bb->full)
+		return;
+	r = bb->nrows - 1;
+	n = bb->bits[r];
+	if(n >= CMT_BB_BITS)
+		return;
+	if(v) bb->b[r][n >> 3] |= (uint8_t)(0x80 >> (n & 7));
+	else  bb->b[r][n >> 3] &= (uint8_t)~(0x80 >> (n & 7));
+	bb->bits[r] = (uint16_t)(n + 1);
+}
+
+static int bb_get(const cmt_bb_t *bb, int r, int i)
+{
+	if(i < 0 || i >= bb->bits[r]) return 0;
+	return (bb->b[r][i >> 3] >> (7 - (i & 7))) & 1;
+}
+
+/* n Bytes ab Bit start (hinter dem Zeilenende = 0) */
+static void bb_bytes(const cmt_bb_t *bb, int r, int start, uint8_t *out, int n)
+{
+	int i;
+
+	memset(out, 0, (size_t)n);
+	for(i = 0; i < n * 8; i++)
+		if(bb_get(bb, r, start + i))
+			out[i >> 3] |= (uint8_t)(0x80 >> (i & 7));
+}
+
+static void bb_invert(cmt_bb_t *bb)
+{
+	int r, i;
+
+	for(r = 0; r < bb->nrows; r++)
+		for(i = 0; i < (bb->bits[r] + 7) / 8; i++)
+			bb->b[r][i] = (uint8_t)~bb->b[r][i];
+}
+
+static int bb_equal(const cmt_bb_t *bb, int a, int b)
+{
+	int i;
+
+	if(bb->bits[a] != bb->bits[b])
+		return 0;
+	for(i = 0; i < bb->bits[a]; i++)
+		if(bb_get(bb, a, i) != bb_get(bb, b, i))
+			return 0;
+	return 1;
+}
+
+/* erste Zeile mit >= minBits Bits, die mindestens minRep-mal vorkommt, sonst -1 */
+static int bb_repeated(const cmt_bb_t *bb, int minRep, int minBits)
+{
+	int i, j, c;
+
+	for(i = 0; i < bb->nrows; i++)
+	{
+		if(bb->bits[i] < minBits)
+			continue;
+		for(c = 1, j = i + 1; j < bb->nrows; j++)
+			if(bb_equal(bb, i, j))
+				c++;
+		if(c >= minRep)
+			return i;
+	}
+	return -1;
+}
+
+/* Bitmuster (MSB zuerst) in Zeile r ab Bit start suchen. Rueckgabe Position oder -1 */
+static int bb_search(const cmt_bb_t *bb, int r, int start, const uint8_t *pat, int plen)
+{
+	int i, j;
+
+	for(i = start; i + plen <= bb->bits[r]; i++)
+	{
+		for(j = 0; j < plen; j++)
+			if(bb_get(bb, r, i + j) != ((pat[j >> 3] >> (7 - (j & 7))) & 1))
+				break;
+		if(j == plen)
+			return i;
+	}
+	return -1;
+}
