+#if CMT_ENABLE_MQTT
+/* MQTT-Warteschlange: ein Publish dauert mit Verbindung ~80..120 ms (TCPIP-Lock, Senden), eine
+ * Sensor-Meldung hat bis zu 16 Publishes -> ~2 s am Stueck im Timer-Task (dort wird auch der
+ * Watchdog gefuettert). Deshalb Topic/Wert fertig formatiert puffern und je Quick-Tick nur EINEN
+ * Publish senden (cmt_pq_tick). Eintrag: Flag-Byte, Name, 0, Wert, 0.
+ * Ohne Verbindung wird nichts gepuffert (Publish wuerde bis 500 ms auf den Mutex warten). */
+#define CMT_PQ_SIZE 1024                     /* eine Sensor-Meldung ~370 Byte: reicht fuer ~2,5 */
+#define CMT_PQ_COPY 0x01                     /* zusaetzlich ohne "/get" melden */
+static char s_pq[CMT_PQ_SIZE];
+static int s_pqR, s_pqW, s_pqStep;
+static uint32_t s_pqLost, s_pqSent;
+
+static void cmt_pq_push(const char *name, const char *val, int flags)
+{
+	int ln = (int)strlen(name) + 1, lv = (int)strlen(val) + 1;
+
+	if(!Main_HasMQTTConnected())
+		return;
+	if(s_pqR == s_pqW)
+		s_pqR = s_pqW = 0;
+	if(s_pqW + 1 + ln + lv > CMT_PQ_SIZE)
+	{
+		s_pqLost++;
+		return;
+	}
+	s_pq[s_pqW++] = (char)flags;
+	memcpy(s_pq + s_pqW, name, (size_t)ln);
+	s_pqW += ln;
+	memcpy(s_pq + s_pqW, val, (size_t)lv);
+	s_pqW += lv;
+}
+
+/* Quick-Tick: hoechstens einen Publish senden */
+static void cmt_pq_tick(void)
+{
+	const char *name, *val;
+	int flags, ln;
+
+	if(s_pqR == s_pqW)
+		return;
+	if(!Main_HasMQTTConnected())
+	{
+		s_pqLost++;
+		s_pqR = s_pqW = s_pqStep = 0;
+		return;
+	}
+	flags = (unsigned char)s_pq[s_pqR];
+	(void)flags;
+	name = s_pq + s_pqR + 1;
+	ln = (int)strlen(name) + 1;
+	val = name + ln;
+	if(s_pqStep == 0)
+	{
+		MQTT_PublishMain_StringString(name, val, OBK_PUBLISH_FLAG_MUTEX_SILENT);
+		s_pqSent++;
+#if CMT_MQTT_NO_GET_COPY && defined(OBK_PUBLISH_FLAG_FORCE_REMOVE_GET)
+		if(flags & CMT_PQ_COPY)
+		{
+			s_pqStep = 1;                        /* Kopie ohne /get im naechsten Tick */
+			return;
+		}
+#endif
+	}
+#if CMT_MQTT_NO_GET_COPY && defined(OBK_PUBLISH_FLAG_FORCE_REMOVE_GET)
+	else
+	{
+		MQTT_PublishMain_StringString(name, val, OBK_PUBLISH_FLAG_MUTEX_SILENT | OBK_PUBLISH_FLAG_FORCE_REMOVE_GET);
+		s_pqSent++;
+	}
+#endif
+	s_pqStep = 0;
+	s_pqR += 1 + ln + (int)strlen(val) + 1;
+}
+
+/* Einzelwert melden: <Geraet>/<name>/get und (falls moeglich) zusaetzlich <Geraet>/<name> */
+static void cmt_mqtt_value(const char *name, const char *val)
+{
+	cmt_pq_push(name, val, CMT_PQ_COPY);
+}
+#else
+static void cmt_pq_tick(void) {}
+#endif
+
+/* Verlauf fuer die Hauptseite */
+#define CMT_HIST_N   8
+#define CMT_HIST_LEN 112
+static struct { char txt[CMT_HIST_LEN]; uint32_t ms; uint16_t n; } s_hist[CMT_HIST_N];
+static int s_histHead;
+
+static void cmt_hist_add(const char *txt)
+{
+	int i, last = (s_histHead + CMT_HIST_N - 1) % CMT_HIST_N;
+
+	if(s_hist[last].n && !strncmp(s_hist[last].txt, txt, CMT_HIST_LEN - 1))
+	{
+		s_hist[last].ms = rtos_get_time();
+		if(s_hist[last].n < 65535) s_hist[last].n++;
+		return;
+	}
+	i = s_histHead;
+	snprintf(s_hist[i].txt, CMT_HIST_LEN, "%s", txt);
+	s_hist[i].ms = rtos_get_time();
+	s_hist[i].n = 1;
+	s_histHead = (s_histHead + 1) % CMT_HIST_N;
+}
+
+/* Spy: Datensaetze nur sammeln und am Ende ausgeben */
+#define CMT_SPY_HITS 8
+static int s_spyMode;
+static int s_spyHitN;
+static struct { char txt[CMT_HIST_LEN]; int n; } s_spyHit[CMT_SPY_HITS];
+
+static void cmt_rec_publish(const cmt_rec_t *r)
+{
+	const cmt_dev_t *d = cmt_dev(r->dev);
+	static char js[240];
+
+	cmt_rec_fmt(r, js, sizeof(js), 0);
+	ADDLOG_INFO(LOG_FEATURE_MAIN, "CMT %s %s", d->kind == CMT_K_SENSOR ? "RfSensor" : "RfProtocol", js);
+	cmt_hist_add(js);
+#if CMT_ENABLE_MQTT
+	{
+		static char val[24], top[40];
+		int i;
+
+		cmt_rec_fmt(r, js, sizeof(js), 1);
+		if(d->kind != CMT_K_SENSOR)
+		{
+			cmt_mqtt_value("RfProtocol", js);
+		}
+		else
+		{
+			cmt_mqtt_value("RfSensor", js);
+			cmt_mqtt_value("RfSensorProtocol", d->name);
+			for(i = 0; i < r->n; i++)
+			{
+				const cmt_fld_t *f = &r->f[i];
+
+				if(f->t == CMT_F_INT && !strcmp(f->k, "Channel"))
+				{
+					snprintf(top, sizeof(top), "RfSensorCh%d", (int)f->v);
+					cmt_mqtt_value(top, js);
+				}
+				switch(f->t)
+				{
+				case CMT_F_TENTH: cmt_fmt_tenth(val, sizeof(val), f->v); break;
+				case CMT_F_HEX:   snprintf(val, sizeof(val), "%0*X", f->w, (unsigned)f->v); break;
+				case CMT_F_STR:   snprintf(val, sizeof(val), "%s", f->s ? f->s : ""); break;
+				default:          snprintf(val, sizeof(val), "%d", (int)f->v); break;
+				}
+				snprintf(top, sizeof(top), "RfSensor%s", f->k);
+				cmt_mqtt_value(top, val);
+			}
+		}
+	}
+#endif
+	CMT_LED_FLASH();
+}
+
+/* Datensatz melden: entprellen, zaehlen, ausgeben. Rueckgabe 1 */
+static int cmt_emit(cmt_rec_t *r)
+{
+	const cmt_dev_t *d = cmt_dev(r->dev);
+	uint32_t key = 2166136261u, now = rtos_get_time(), win;
+	int i;
+	const char *c;
+
+	for(i = 0; i < r->n; i++)
+	{
+		key = (key ^ (uint32_t)r->f[i].v) * 16777619u;
+		for(c = r->f[i].s; c && *c; c++)
+			key = (key ^ (uint8_t)*c) * 16777619u;
+	}
+	for(c = r->data; *c; c++)
+		key = (key ^ (uint8_t)*c) * 16777619u;
+
+	if(s_spyMode)
+	{
+		static char txt[CMT_HIST_LEN];
+
+		cmt_rec_fmt(r, txt, sizeof(txt), 0);
+		for(i = 0; i < s_spyHitN; i++)
+			if(!strcmp(s_spyHit[i].txt, txt))
+			{
+				s_spyHit[i].n++;
+				return 1;
+			}
+		if(s_spyHitN < CMT_SPY_HITS)
+		{
+			snprintf(s_spyHit[s_spyHitN].txt, CMT_HIST_LEN, "%s", txt);
+			s_spyHit[s_spyHitN].n = 1;
+			s_spyHitN++;
+		}
+		return 1;
+	}
+	win = d->kind == CMT_K_SENSOR ? CMT_SENS_REPORT_MS : CMT_REMOTE_REPORT_MS;
+	if(s_dst[r->dev].reports && key == s_dst[r->dev].key && (now - s_dst[r->dev].lastMs) < win)
+	{
+		s_dst[r->dev].lastMs = now;           /* gehaltene Taste: erst nach einer Pause erneut melden */
+		return 1;
+	}
+	s_dst[r->dev].key = key;
+	s_dst[r->dev].lastMs = now;
+	s_dst[r->dev].reports++;
+	s_recTotal++;
+	cmt_rec_publish(r);
+	return 1;
+}
+
+/* ---- Paketsammler ---- */
+/* Paare je Sammelpuffer. Laeuft er voll, gleitet das Fenster (cmt_pk_slide), am Paketende stehen
+ * die letzten 384..512 Paare: genug fuer mehrere Wiederholungen jedes Telegramms (Nexus 37 Paare).
+ * RAM: 2 Puffer x 2 x 2 Byte je Paar = 4 KB (der Heap ist knapp, OBK startet unter 25 KB frei neu). */
+#define CMT_PK_MAX   512
+#define CMT_PK_END   25000
+/* zwei Pufferpaare: eines sammelt (s_pkP/G), eines wird ausgewertet (s_wkP/G) */
+static uint16_t s_pkBufP[2][CMT_PK_MAX], s_pkBufG[2][CMT_PK_MAX];
+static uint16_t *s_pkP = s_pkBufP[0], *s_pkG = s_pkBufG[0];
+static uint16_t *s_wkP = s_pkBufP[1], *s_wkG = s_pkBufG[1];
+static int      s_wkN;
+static int      s_pkN, s_pkPend;
+static uint16_t s_pkPulse;
+static uint32_t s_pkLastMs, s_pkCount;
+
+static int cmt_tolw(const cmt_dev_t *d, int w) { return d->tol ? d->tol : w / 4; }
+static inline __attribute__((always_inline)) int cmt_in(int v, int w, int t) { return v > w - t && v < w + t; }
+
+static void cmt_msg(int di, const cmt_dev_t *d)
+{
+	if(s_bb.nrows == 0 || (s_bb.nrows == 1 && s_bb.bits[0] == 0))
+		return;
+	s_dst[di].msgs++;
+	d->dec(di, &s_bb);
+}
+
+static void cmt_slice(int di, const cmt_dev_t *d)
+{
+	int i, n = s_wkN, mid = (d->s + d->l) / 2;
+
+	bb_clear(&s_bb);
+	if(d->mod == CMT_MOD_PPM)
+	{
+		/* Sync: mind. 25 %, aber nie bis ins Fenster der langen Pause */
+		int ts = d->sync / 4 > d->tol ? d->sync / 4 : d->tol;
+
+		int tws = d->s / 4 > d->tol ? d->s / 4 : d->tol, twl = d->l / 4 > d->tol ? d->l / 4 : d->tol;
+
+		if(d->sync > d->l && ts > (d->sync - d->l) / 2)
+			ts = (d->sync - d->l) / 2;
+		if(d->s + tws > d->l - twl)
+			tws = twl = (d->l - d->s) / 2;
+		for(i = 0; i < n; i++)
+		{
+			int g = s_wkG[i];
+
+			if(i == n - 1 || g >= d->reset)
+			{
+				cmt_msg(di, d);
+				bb_clear(&s_bb);
+				continue;
+			}
+			if(d->tol)
+			{
+				/* Fenster wie rtl_433, Toleranz aber mind. 25 % (50-us-Abtastung, verzerrte Pulse) */
+				if(cmt_in(g, d->s, tws))      bb_bit(&s_bb, 0);
+				else if(cmt_in(g, d->l, twl)) bb_bit(&s_bb, 1);
+				else if(d->sync && cmt_in(g, d->sync, ts)) bb_sync(&s_bb);
+				else bb_row(&s_bb);
+				continue;
+			}
+			if(d->sync && cmt_in(g, d->sync, ts)) { bb_sync(&s_bb); continue; }
+			if(d->gapl && g > d->gapl)            { bb_row(&s_bb); continue; }
+			bb_bit(&s_bb, g > mid);
+		}
+	}
+	else if(d->mod == CMT_MOD_PWM)
+	{
+		int ts = cmt_tolw(d, d->sync), t = d->tol ? d->tol : (d->l - d->s) / 2, tl = t;
+		int tper = d->per / 5 > 150 ? d->per / 5 : 150, bad = 0, skSum = 0, skN = 0, sk = 0;
+
+		if(d->tol)
+		{
+			if(d->s / 4 > t) t = d->s / 4;
+			if(d->l / 4 > tl) tl = d->l / 4;
+			if(d->s + t > d->l - tl) t = tl = (d->l - d->s) / 2;
+		}
+		if(d->sync > d->l && ts > (d->sync - d->l) / 2)
+			ts = (d->sync - d->l) / 2;
+		for(i = 0; i < n; i++)
+		{
+			int p = s_wkP[i], g = s_wkG[i];
+			int endMsg = (i == n - 1 || g > d->reset), endRow = endMsg || (d->gapl && g > d->gapl);
+			/* Sync: bei fester Periode ueber Puls + Pause (= 2 x Sync, unabhaengig von Verzerrung), sonst Pulsbreite */
+			int isSync = d->sync && (d->per && !endRow ? (p > mid && cmt_in(p + g, 2 * d->sync, 2 * d->sync / 5))
+			                                           : cmt_in(p, d->sync, ts));
+
+			if(isSync)
+			{
+				bb_sync(&s_bb);
+				/* Sync ist symmetrisch (Puls = Pause): daraus die Verzerrung (High laenger) schaetzen */
+				if(d->per && cmt_in(g, d->sync, d->sync / 2))
+					sk = (p - g) / 2;
+			}
+			else if(d->per)
+			{
+				/* feste Periode (kurzer Puls + lange Pause und umgekehrt): Bit aus Puls < Pause,
+				 * unempfindlich gegen gestreckte Pulse. Letztes Bit der Zeile: Schwelle + mittlere Verzerrung */
+				if(p < d->s / 2)
+					;                                    /* Stoerimpuls */
+				else if(p > d->l + (d->l - d->s))
+				{
+					bb_row(&s_bb);
+					bad = 0;
+				}
+				else if(!endRow)
+				{
+					if(!cmt_in(p + g, d->per, tper))
+						bad = 1;                         /* anderes Protokoll: Zeile verwerfen */
+					else
+					{
+						int bit = p - sk < g + sk;
+
+						bb_bit(&s_bb, bit);
+						skSum += p - (bit ? d->s : d->l);
+						skN++;
+					}
+				}
+				else
+					bb_bit(&s_bb, p - (skN ? skSum / skN : sk) <= mid);
+			}
+			else if(cmt_in(p, d->s, t))
+				bb_bit(&s_bb, 1);
+			else if(cmt_in(p, d->l, tl) || (!d->tol && p > d->s && p < d->l + t))
+				bb_bit(&s_bb, p <= mid);
+			else if(p > d->s - t)
+				bb_row(&s_bb);                           /* zu langer Puls: neue Zeile, zu kurzer wird ignoriert */
+			if(bad && s_bb.nrows)
+				s_bb.bits[s_bb.nrows - 1] = 0;
+			if(endRow)
+			{
+				bad = 0;
+				skSum = skN = 0;
+				if(endMsg)
+				{
+					cmt_msg(di, d);
+					bb_clear(&s_bb);
+				}
+				else
+					bb_row(&s_bb);
+			}
+		}
+	}
+	else if(d->mod == CMT_MOD_PCM)
+	{
+		int T = d->s, k;
+
+		for(i = 0; i < n; i++)
+		{
+			int p = s_wkP[i], g = s_wkG[i], np = (p + T / 2) / T, ng;
+
+			if(np < 1) np = 1;
+			if(np > 32) np = 32;
+			if(d->tol && p > d->tol)
+				bb_row(&s_bb);                       /* zu langer Puls (Manchester hat max. 2T): neue Zeile */
+			else
+				for(k = 0; k < np; k++)
+					bb_bit(&s_bb, 1);
+			if(i == n - 1 || g > d->reset)
+			{
+				cmt_msg(di, d);
+				bb_clear(&s_bb);
+				continue;
+			}
+			if(d->gapl && g > d->gapl)
+			{
+				bb_row(&s_bb);
+				continue;
+			}
+			ng = (g + T / 2) / T;
+			if(ng > 32) ng = 32;
+			for(k = 0; k < ng; k++)
+				bb_bit(&s_bb, 0);
+		}
+	}
+	else if(d->mod == CMT_MOD_DMC)
+	{
+		int ts = cmt_tolw(d, d->s), tl = cmt_tolw(d, d->l), half = 0, j;
+
+		for(j = 0; j < 2 * n; j++)
+		{
+			int w = (j & 1) ? s_wkG[j >> 1] : s_wkP[j >> 1];
+
+			if((j & 1) && (j == 2 * n - 1 || w >= d->reset))
+			{
+				cmt_msg(di, d);
+				bb_clear(&s_bb);
+				half = 0;
+				continue;
+			}
+			if(cmt_in(w, d->s, ts))
+			{
+				if(half) { bb_bit(&s_bb, 1); half = 0; }
+				else half = 1;
+			}
+			else if(cmt_in(w, d->l, tl) && !half)
+				bb_bit(&s_bb, 0);
+			else
+			{
+				bb_row(&s_bb);
+				half = 0;
+			}
+		}
+	}
+	else if(d->mod == CMT_MOD_RCS)
+	{
+		/* Puls +-40 % von kurz (mind. 75 us), Periode +-15 %, Sync-Puls +-40 % */
+		int period = d->pw ? d->pw : d->s + d->l, tp = period * 15 / 100, t = d->s * 2 / 5, tl = d->l / 4;
+
+		if(t < 75) t = 75;
+		if(t > (d->l - d->s) / 2) t = (d->l - d->s) / 2;
+		if(tl < t) tl = t;
+		if(tl > (d->l - d->s) / 2) tl = (d->l - d->s) / 2;
+		int bad = 0;
+
+		if(tp < 100) tp = 100;
+		for(i = 0; i < n; i++)
+		{
+			int p = s_wkP[i], g = s_wkG[i];
+
+			if(i == n - 1 || g > d->reset)
+			{
+				if(bad && s_bb.nrows) s_bb.bits[s_bb.nrows - 1] = 0;
+				cmt_msg(di, d);
+				bb_clear(&s_bb);
+				bad = 0;
+				continue;
+			}
+			if(g > d->gapl)
+			{
+				/* Sync-Puls + Luecke: Zeilenende. Falscher Sync-Puls: Zeile gehoert zu einem anderen Protokoll */
+				if(((d->sync && !cmt_in(p, d->sync, d->sync * 2 / 5 + 50)) || bad) && s_bb.nrows)
+					s_bb.bits[s_bb.nrows - 1] = 0;
+				bb_row(&s_bb);
+				bad = 0;
+				continue;
+			}
+			/* Periode muss passen, Puls und Pause klar verschieden: Bit = Puls laenger als Pause
+			 * (unempfindlich gegen gestreckte Pulse; Protokolle unterscheiden sich in Periode und Sync) */
+			if(cmt_in(p + g, period, tp) && (p * 10 < g * 8 || g * 10 < p * 8))
+				bb_bit(&s_bb, p > g);
+			else
+			{
+				/* ungueltig: ganze Zeile bis zum naechsten Sync verwerfen */
+				if(s_bb.nrows) s_bb.bits[s_bb.nrows - 1] = 0;
+				bad = 1;
+			}
+		}
+	}
+}
+
+/* Rechenzeit verteilen: die Auswertung laeuft im Timer-Task (Quick-Tick), dort wird auch der
+ * Watchdog (Main_OnEverySecond) gefuettert. Ein Paket mit ~1000 Paaren braucht fuer alle Geraete
+ * ~150..200 ms (Code laeuft aus dem Flash). Deshalb: fertiges Paket in einen Arbeitspuffer
+ * uebernehmen und je Quick-Tick nur so viele Geraete auswerten, bis CMT_PK_SLICE_MS verbraucht
+ * sind. Kommt waehrenddessen ein weiteres Paket, wird es verworfen (gezaehlt). */
+#define CMT_PK_SLICE_MS 15
+static uint32_t s_pkDropped, s_pkSplit, s_pkMaxMs;
+static uint32_t s_pkFull, s_pkPairs, s_pkSumMs;   /* Statistik: gekuerzte Pakete, Summe Paare, Summe ms */
+static uint32_t s_pkFullSkip, s_pkFullRep;       /* gekuerzte Pakete uebersprungen / Meldungen daraus */
+static uint32_t s_pkSlides;                      /* Verschiebungen des Fensters */
+static int s_pkStartDev, s_pkSlid;
+/* Gleitendes Fenster: laeuft der Sammelpuffer voll (Dauerrauschen ohne Pause), wird das Paket NICHT
+ * beendet, sondern die aeltesten Paare fallen weg (es bleiben CMT_PK_KEEP). Erst eine echte Pause
+ * (>= CMT_PK_END) oder Funkstille beendet das Paket. Ein Telegramm, dem Rauschen ohne Pause
+ * vorausgeht, steht so am Ende des Puffers und wird ausgewertet; Rauschen ohne Ende kostet nichts.
+ * (Messung vorher: volle Pakete zu verwerfen kostete echte Telegramme.)
+ * "cmtproto voll off" ueberspringt gekuerzte Pakete (zum Vergleich). */
+#define CMT_PK_KEEP  (CMT_PK_MAX * 3 / 4)
+static int s_pkUseFull = 1;
+/* Arbeitsauftrag */
+static int s_wkBusy, s_wkK, s_wkFull, s_wkTicks;
+static uint32_t s_wkRec0, s_wkMs;
+/* Ersatzpuffer: wird ein KURZES Paket fertig, waehrend noch ausgewertet wird, wartet es hier und
+ * kommt direkt danach dran (z.B. 2. Zeile von WH2, 48 ms nach der ersten - die erste ist oft durch
+ * Rauschen davor verdorben, die zweite sauber). Lange Pakete werden weiter verworfen (RAM). */
+#define CMT_PK_SPARE 160
+static uint16_t s_spP[CMT_PK_SPARE], s_spG[CMT_PK_SPARE];
+static int s_spN, s_spFull;
+static uint32_t s_pkSpared;
+
+/* Auftrag aus s_wkP/s_wkG (n Paare) anlegen */
+static void cmt_pk_job(int n, int full)
+{
+	s_wkN = n;
+	s_wkFull = full;
+	s_wkRec0 = s_recTotal;
+	s_wkMs = 0;
+	s_wkTicks = 0;
+	s_wkK = 0;
+	s_wkBusy = 1;
+	s_pkStartDev = (s_pkStartDev + 1) % CMT_DEV_MAX;
+}
+
+static void cmt_pk_finish(void)
+{
+	if(s_wkFull)
+		s_pkFullRep += s_recTotal - s_wkRec0;
+	s_pkSumMs += s_wkMs;
+	if(s_wkMs > s_pkMaxMs)
+		s_pkMaxMs = s_wkMs;
+	if(s_wkTicks > 1)
+		s_pkSplit++;
+	s_wkBusy = 0;
+	if(s_spN)
+	{
+		/* wartendes kurzes Paket in den (jetzt freien) Arbeitspuffer und auswerten */
+		memcpy(s_wkP, s_spP, (size_t)s_spN * sizeof(s_spP[0]));
+		memcpy(s_wkG, s_spG, (size_t)s_spN * sizeof(s_spG[0]));
+		cmt_pk_job(s_spN, s_spFull);
+		s_spN = 0;
+	}
+}
+
+/* Arbeitsauftrag fortsetzen, hoechstens budgetMs (0 = bis zum Ende) */
+static void cmt_pk_work(uint32_t budgetMs)
+{
+	uint32_t t0, td;
+
+	if(!s_wkBusy)
+		return;
+	t0 = rtos_get_time();
+	s_wkTicks++;
+	while(s_wkK < CMT_DEV_MAX)
+	{
+		int i = (s_pkStartDev + s_wkK) % CMT_DEV_MAX;
+		const cmt_dev_t *d = cmt_dev(i);
+
+		s_wkK++;
+		if(d && !s_devOff[i] && d->dec)
+		{
+			td = rtos_get_time();
+			cmt_slice(i, d);
+			td = rtos_get_time() - td;
+			s_dst[i].sumMs += td;
+			if(td > s_dst[i].maxMs)
+				s_dst[i].maxMs = td;
+		}
+		if(budgetMs && rtos_get_time() - t0 >= budgetMs)
+			break;
+	}
+	s_wkMs += rtos_get_time() - t0;
+	if(s_wkK >= CMT_DEV_MAX)
+		cmt_pk_finish();
+}
+
+/* Fertiges Sammelpaket als Arbeitsauftrag uebernehmen (Puffer tauschen) */
+static void cmt_pk_start(int full)
+{
+	uint16_t *t;
+
+	s_pkCount++;
+	s_pkPairs += (uint32_t)s_pkN;
+	if(full)
+	{
+		s_pkFull++;
+		if(!s_pkUseFull && !s_spyMode)
+		{
+			s_pkFullSkip++;
+			return;
+		}
+	}
+	if(s_wkBusy)
+	{
+		if(!s_spyMode)
+		{
+			if(s_pkN <= CMT_PK_SPARE && !s_spN)
+			{
+				/* kurzes Paket: im Ersatzpuffer warten lassen */
+				memcpy(s_spP, s_pkP, (size_t)s_pkN * sizeof(s_spP[0]));
+				memcpy(s_spG, s_pkG, (size_t)s_pkN * sizeof(s_spG[0]));
+				s_spN = s_pkN;
+				s_spFull = full;
+				s_pkSpared++;
+				return;
+			}
+			s_pkDropped++;                       /* Auswertung laeuft noch: Paket verwerfen */
+			return;
+		}
+		cmt_pk_work(0);
+	}
+	t = s_wkP; s_wkP = s_pkP; s_pkP = t;
+	t = s_wkG; s_wkG = s_pkG; s_pkG = t;
+	cmt_pk_job(s_pkN, full);
+	if(s_spyMode)
+		cmt_pk_work(0);                          /* Spy: sofort komplett auswerten */
+}
+
+static void cmt_pk_end(void)
+{
+	if(s_pkPend && s_pkN < CMT_PK_MAX)
+	{
+		s_pkP[s_pkN] = s_pkPulse;
+		s_pkG[s_pkN] = 65535;
+		s_pkN++;
+	}
+	if(s_pkN >= 4)
+		cmt_pk_start(s_pkSlid);
+	s_pkN = 0;
+	s_pkPend = 0;
+	s_pkSlid = 0;
+}
+
+/* Puffer voll: aelteste Paare verwerfen, Paket laeuft weiter */
+static void cmt_pk_slide(void)
+{
+	int drop = s_pkN - CMT_PK_KEEP;
+
+	if(drop <= 0)
+		return;
+	memmove(s_pkP, s_pkP + drop, (size_t)CMT_PK_KEEP * sizeof(s_pkP[0]));
+	memmove(s_pkG, s_pkG + drop, (size_t)CMT_PK_KEEP * sizeof(s_pkG[0]));
+	s_pkN = CMT_PK_KEEP;
+	s_pkSlid = 1;
+	s_pkSlides++;
+}
+
+/* Wird fuer jeden abgeschlossenen Pegel aufgerufen (parallel zum RfReceived-Decoder) */
+static void cmt_pk_feed(int level, int us)
+{
+	s_pkLastMs = rtos_get_time();
+	if(us > 65535) us = 65535;
+	if(level)
+	{
+		if(us >= CMT_PK_END)
+		{
+			cmt_pk_end();
+			return;
+		}
+		s_pkPulse = (uint16_t)us;
+		s_pkPend = 1;
+		return;
+	}
+	if(!s_pkPend)
+		return;
+	s_pkP[s_pkN] = s_pkPulse;
+	s_pkG[s_pkN] = (uint16_t)us;
+	s_pkN++;
+	s_pkPend = 0;
+	if(us >= CMT_PK_END)
+		cmt_pk_end();
+	else if(s_pkN >= CMT_PK_MAX)
+		cmt_pk_slide();
+}
+
+/* Quick-Tick: Funkstille ohne Flanke beendet das Paket, laufende Auswertung fortsetzen */
+static void cmt_pk_tick(void)
+{
+	if((s_pkN || s_pkPend) && (rtos_get_time() - s_pkLastMs) > 40)
+		cmt_pk_end();
+	cmt_pk_work(CMT_PK_SLICE_MS);
+}
+
+static void cmt_pk_reset(void)
+{
+	s_pkN = 0;
+	s_pkPend = 0;
+	s_pkSlid = 0;
+	s_spN = 0;
+	s_wkBusy = 0;
+}
+
+/* ====================================================================
+ *  Decoder
+ * ==================================================================== */
+static void rec_sensor(cmt_rec_t *r, int id, int idw, int ch, int bat)
+{
+	rec_hex(r, "Id", (uint32_t)id, idw);
+	if(ch > 0) rec_int(r, "Channel", ch);
+	if(bat >= 0) rec_int(r, "Battery", bat);
+}
+
+/* Rubicson: ID(8) Batt(1) 0 Kanal-1(2) Temp(12) 1111 CRC-8(Poly 0x31, Init 0x6C) */
+static int cmt_rubicson_ok(const uint8_t *b)
+{
+	uint8_t m[4];
+
+	m[0] = b[0]; m[1] = b[1]; m[2] = b[2]; m[3] = 0xF0;
+	return (b[3] & 0xF0) == 0xF0 && cmt_crc8(m, 4, 0x31, 0x6C) == (uint8_t)(((b[3] & 0x0F) << 4) | (b[4] >> 4));
+}
+
+static int cmt_d_rubicson(int d, cmt_bb_t *bb)
+{
+	int r, t;
+	uint8_t b[5];
+	cmt_rec_t *const op = &s_rec;
+
+	for(r = 0; r < bb->nrows; r++)
+	{
+		if(bb->bits[r] < 36 || bb->bits[r] > 38)
+			continue;
+		bb_bytes(bb, r, 0, b, 5);
+		if(!cmt_rubicson_ok(b))
+			continue;
+		t = cmt_s12(((b[1] & 0x0F) << 8) | b[2]);
+		if(t < -400 || t > 800)
+			continue;
+		rec_init(op, d);
+		rec_sensor(op, b[0], 2, ((b[1] >> 4) & 3) + 1, b[1] >> 7);
+		rec_tenth(op, "Temperature", t);
+		return cmt_emit(op);
+	}
+	return 0;
+}
+
+/* Nexus: ID(8) Batt(1) Taste(1) Kanal-1(2) Temp(12) 1111 Feuchte(8), zwei gleiche Zeilen noetig */
+static int cmt_d_nexus(int d, cmt_bb_t *bb)
+{
+	int r = bb_repeated(bb, 2, 36), t, h;
+	uint8_t b[5];
+	cmt_rec_t *const op = &s_rec;
+
+	if(r < 0 || bb->bits[r] != 36)
+		return 0;
+	bb_bytes(bb, r, 0, b, 5);
+	if((b[3] >> 4) != 0xF || cmt_rubicson_ok(b))
+		return 0;
+	t = cmt_s12(((b[1] & 0x0F) << 8) | b[2]);
+	h = ((b[3] & 0x0F) << 4) | (b[4] >> 4);
+	if(h > 100 || t < -400 || t > 800)
+		return 0;
+	rec_init(op, d);
+	rec_sensor(op, b[0], 2, ((b[1] >> 4) & 3) + 1, b[1] >> 7);
+	rec_tenth(op, "Temperature", t);
+	rec_int(op, "Humidity", h);
+	return cmt_emit(op);
+}
+
+/* Prologue: Typ(4: 5/9) ID(8) Batt(1) Taste(1) Kanal-1(2) Temp(12) Feuchte(8, CC = keine) */
+static int cmt_d_prologue(int d, cmt_bb_t *bb)
+{
+	int r = bb_repeated(bb, 3, 36), t, h, type;
+	uint8_t b[5];
+	cmt_rec_t *const op = &s_rec;
+
+	if(r < 0 || bb->bits[r] > 37)
+		return 0;
+	bb_bytes(bb, r, 0, b, 5);
+	type = b[0] >> 4;
+	if(type != 5 && type != 9)
+		return 0;
+	t = cmt_s12((b[2] << 4) | (b[3] >> 4));
+	h = ((b[3] & 0x0F) << 4) | (b[4] >> 4);
+	if(t < -400 || t > 800 || (h > 100 && h != 0xCC))
+		return 0;
+	rec_init(op, d);
+	rec_sensor(op, ((b[0] & 0x0F) << 4) | (b[1] >> 4), 2, (b[1] & 3) + 1, (b[1] >> 3) & 1);
+	rec_tenth(op, "Temperature", t);
+	if(h != 0xCC) rec_int(op, "Humidity", h);
+	rec_int(op, "Button", (b[1] >> 2) & 1);
+	return cmt_emit(op);
+}
+
+/* inFactory: ID(8) CRC(4) Taste(1) BattLow(1) 00 Temp(12, 0,1 F + 90) Feuchte(2x BCD) Kanal(2) 00 */
+static uint8_t cmt_infactory_crc(const uint8_t *b)
+{
+	uint8_t m[4];
+
+	m[0] = b[0];
+	m[1] = (uint8_t)((b[1] & 0x0F) | ((b[4] & 0x0F) << 4));
+	m[2] = b[2];
+	m[3] = b[3];
+	return (uint8_t)(cmt_crc4(m, 4, 0x13, 0) ^ (b[4] >> 4));
+}
+
+static int cmt_d_infactory(int d, cmt_bb_t *bb)
+{
+	int r, h10, h1, ch, tc, hum;
+	uint8_t b[5];
+	cmt_rec_t *const op = &s_rec;
+
+	for(r = 0; r < bb->nrows; r++)
+	{
+		if(bb->bits[r] < 40 || bb->bits[r] > 42)
+			continue;
+		bb_bytes(bb, r, 0, b, 5);
+		ch = (b[4] >> 2) & 3;
+		if(ch == 0 || cmt_infactory_crc(b) != (b[1] >> 4))
+			continue;
+		h10 = b[3] & 0x0F;
+		h1 = b[4] >> 4;
+		hum = (h10 == 0x0A && h1 == 0) ? 100 : h10 * 10 + h1;
+		tc = cmt_f2c(((b[2] << 4) | (b[3] >> 4)) - 900);
+		if(h10 > 0x0A || h1 > 9 || hum > 100 || tc < -400 || tc > 700)
+			continue;
+		rec_init(op, d);
+		rec_sensor(op, b[0], 2, ch, (b[1] & 0x04) ? 0 : 1);
+		rec_tenth(op, "Temperature", tc);
+		rec_int(op, "Humidity", hum);
+		return cmt_emit(op);
+	}
+	return 0;
+}
+
+/* GT-WT-02: ID(8) BattLow(1) Taste(1) Kanal(2) Temp(12) Feuchte(7) Summe(6) */
+static int cmt_gtwt02_sum(const uint8_t *b)
+{
+	return ((b[0] >> 4) + (b[0] & 0xF) + (b[1] >> 4) + (b[1] & 0xF) + (b[2] >> 4) + (b[2] & 0xF)
+		+ (b[3] >> 4) + (b[3] & 0xE)) & 0x3F;
+}
+
+static int cmt_d_gtwt02(int d, cmt_bb_t *bb)
+{
+	int r, t, h, ch;
+	uint8_t b[5];
+	cmt_rec_t *const op = &s_rec;
+
+	for(r = 0; r < bb->nrows; r++)
+	{
+		if(bb->bits[r] != 37 && bb->bits[r] != 39)
+			continue;
+		bb_bytes(bb, r, bb->bits[r] == 39 ? 2 : 0, b, 5);
+		if(!(b[0] | b[1] | b[2] | b[3]))
+			continue;
+		if(cmt_gtwt02_sum(b) != (((b[3] & 1) << 5) | (b[4] >> 3)))
+			continue;
+		ch = (b[1] >> 4) & 3;
+		t = cmt_s12(((b[1] & 0x0F) << 8) | b[2]);
+		h = b[3] >> 1;
+		if(ch > 2 || t < -200 || t > 600)
+			continue;
+		if(h == 10) h = 0;
+		else if(h == 110) h = 100;
+		else if(h < 20 || h > 90) continue;
+		rec_init(op, d);
+		rec_sensor(op, b[0], 2, ch + 1, (b[1] >> 7) ? 0 : 1);
+		rec_tenth(op, "Temperature", t);
+		rec_int(op, "Humidity", h);
+		rec_int(op, "Button", (b[1] >> 6) & 1);
+		return cmt_emit(op);
+	}
+	return 0;
+}
+
+/* Springfield: ID(8) BattLow(1) Taste(1) Kanal(2) Temp(12) Feuchte/10(4) Pruefnibble(4) ?(4) */
+static int cmt_d_springfield(int d, cmt_bb_t *bb)
+{
+	int r = bb_repeated(bb, 3, 36), t, m;
+	uint8_t b[5], x;
+	cmt_rec_t *const op = &s_rec;
+
+	if(r < 0 || bb->bits[r] > 37)
+		return 0;
+	bb_bytes(bb, r, 0, b, 5);
+	if((!b[0] && !b[1] && !b[2] && !b[3]) || (b[0] == 0xFF && b[1] == 0xFF && b[2] == 0xFF && b[3] == 0xFF))
+		return 0;
+	x = (uint8_t)(b[0] ^ b[1] ^ b[2] ^ b[3]);
+	if(((x >> 4) ^ (x & 0x0F)) != 0)
+		return 0;
+	t = cmt_s12(((b[1] & 0x0F) << 8) | b[2]);
+	m = (b[3] >> 4) * 10;
+	if(t < -300 || t > 700 || m > 100)
+		return 0;
+	rec_init(op, d);
+	rec_sensor(op, b[0], 2, ((b[1] >> 4) & 3) + 1, (b[1] >> 7) ? 0 : 1);
+	rec_tenth(op, "Temperature", t);
+	rec_int(op, "Moisture", m);
+	return cmt_emit(op);
+}
+
+/* Acurite 606TX: ID(8) BattOk(1) Taste(1) Kanal(2) Temp(12) LFSR(8) */
+static int cmt_d_acurite606(int d, cmt_bb_t *bb)
+{
+	int r = bb_repeated(bb, 3, 32);
+	uint8_t b[4];
+	cmt_rec_t *const op = &s_rec;
+
+	if(r < 0 || bb->bits[r] > 33)
+		return 0;
+	bb_bytes(bb, r, 0, b, 4);
+	if(!(b[0] | b[1] | b[2] | b[3]) || cmt_lfsr8(b, 3, 0x98, 0xF1) != b[3])
+		return 0;
+	rec_init(op, d);
+	rec_sensor(op, b[0], 2, ((b[1] >> 4) & 3) + 1, b[1] >> 7);
+	rec_tenth(op, "Temperature", cmt_s12(((b[1] & 0x0F) << 8) | b[2]));
+	return cmt_emit(op);
+}
+
+/* Esperanza EWS: 00 ID(8) ?(2) Kanal-1(2) Temp(12, Nibble getauscht, 0,1 F + 90) Feuchte(8, Nibble getauscht) Flags(4) CRC-4 */
+static int cmt_d_esperanza(int d, cmt_bb_t *bb)
+{
+	int r = bb_repeated(bb, 3, 42), raw, hum;
+	uint8_t b[5];
+	cmt_rec_t *const op = &s_rec;
+
+	if(r < 0 || bb->bits[r] != 42)
+		return 0;
+	bb_bytes(bb, r, 2, b, 5);
+	if(!(b[0] | b[1] | b[2] | b[3] | b[4]) || (b[0] & b[1] & b[2] & b[3]) == 0xFF)
+		return 0;                                /* Nullzeile besteht die CRC-4 sonst immer */
+	if((uint8_t)(cmt_crc4(b, 4, 0x3, 0) ^ (b[4] >> 4)) != (b[4] & 0x0F))
+		return 0;
+	raw = ((b[2] & 0x0F) << 8) | (b[2] & 0xF0) | (b[1] & 0x0F);
+	hum = ((b[3] & 0x0F) << 4) | (b[3] >> 4);
+	if(hum > 100)
+		return 0;
+	rec_init(op, d);
+	rec_sensor(op, b[0], 2, ((b[1] >> 4) & 3) + 1, (b[4] & 0x40) ? 0 : 1);
+	rec_tenth(op, "Temperature", cmt_f2c(raw - 900));
+	rec_int(op, "Humidity", hum);
+	return cmt_emit(op);
+}
