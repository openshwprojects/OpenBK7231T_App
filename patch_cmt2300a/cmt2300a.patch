+/* ---- Datensatz ---- */
+#define CMT_F_INT   0
+#define CMT_F_TENTH 1
+#define CMT_F_HEX   2
+#define CMT_F_STR   3
+#define CMT_REC_F   14
+
+typedef struct
+{
+	const char *k;
+	uint8_t t, w;
+	int32_t v;
+	const char *s;
+} cmt_fld_t;
+
+typedef struct
+{
+	int dev, n;
+	cmt_fld_t f[CMT_REC_F];
+	char data[52];       /* Rohdaten als Hex (leer = keine) */
+	int bits;
+} cmt_rec_t;
+
+/* ein gemeinsamer Datensatz (Quick-Tick laeuft nie parallel), spart Stack im Timer-Task (3 KB) */
+static cmt_rec_t s_rec;
+
+static void rec_init(cmt_rec_t *r, int dev) { memset(r, 0, sizeof(*r)); r->dev = dev; }
+static void rec_add(cmt_rec_t *r, const char *k, int t, int w, int32_t v, const char *s)
+{
+	if(r->n >= CMT_REC_F) return;
+	r->f[r->n].k = k; r->f[r->n].t = (uint8_t)t; r->f[r->n].w = (uint8_t)w;
+	r->f[r->n].v = v; r->f[r->n].s = s;
+	r->n++;
+}
+static void rec_int(cmt_rec_t *r, const char *k, int v)            { rec_add(r, k, CMT_F_INT, 0, v, NULL); }
+static void rec_tenth(cmt_rec_t *r, const char *k, int v)          { rec_add(r, k, CMT_F_TENTH, 0, v, NULL); }
+static void rec_hex(cmt_rec_t *r, const char *k, uint32_t v, int w) { rec_add(r, k, CMT_F_HEX, w, (int32_t)v, NULL); }
+static void rec_str(cmt_rec_t *r, const char *k, const char *s)    { rec_add(r, k, CMT_F_STR, 0, 0, s); }
+
+/* Rohdaten aus Zeile row (ab Bit start, nbits Bits) als Hex */
+static void rec_data(cmt_rec_t *r, const cmt_bb_t *bb, int row, int start, int nbits)
+{
+	int i, q = 0, v = 0, k;
+
+	if(nbits > 200) nbits = 200;
+	for(i = 0; i < nbits; i += 4)
+	{
+		for(v = 0, k = 0; k < 4; k++)
+			v = (v << 1) | bb_get(bb, row, start + i + k);
+		if(q < (int)sizeof(r->data) - 1)
+			r->data[q++] = "0123456789ABCDEF"[v];
+	}
+	r->data[q] = 0;
+	r->bits = nbits;
+}
