+/* ---- Geraetetabelle ---- */
+typedef int (*cmt_decfn_t)(int dev, cmt_bb_t *bb);
+
+typedef struct
+{
+	const char *name;
+	uint8_t  mod, kind;
+	uint16_t s, l;          /* kurz/lang; PCM: Bitzeit; DMC: Halb-/Vollbit; RCS: High von 0/1 */
+	uint16_t sync;          /* PPM: Sync-Pause, PWM: Sync-Puls, 0 = keine */
+	uint16_t gapl, reset;   /* Pause > gapl: neue Zeile (0 = nie); > reset: Nachricht zu Ende */
+	uint16_t tol;           /* Toleranz fuer Sync/DMC/RCS, 0 = 25 %; PCM: laengster erlaubter Puls (0 = beliebig) */
+	/* Senden (cmtsensor/cmtsendp) */
+	uint16_t pw;            /* PPM: Pulsbreite; PWM: feste Pause (0 = Rest); RCS: Periode (0 = s+l) */
+	uint16_t txsp, txsg;    /* Vorspann vor jeder Zeile: Puls / Pause (0 = keiner) */
+	uint16_t txgap;         /* Pause nach jeder Zeile */
+	uint8_t  nsync, txrep;  /* PWM: Sync-Pulse vor jeder Zeile; Wiederholungen */
+	cmt_decfn_t dec;
+	const char *descr;
+	uint16_t per;           /* PWM: Puls + Pause muss diese Periode ergeben (+-20 %, mind. 120 us), 0 = keine Pruefung */
+} cmt_dev_t;
