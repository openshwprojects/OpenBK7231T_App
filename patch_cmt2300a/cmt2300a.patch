+/* Fine Offset WH1080 (OOK): FF A+ID Temp(10, +40 C) Feuchte Wind Boe Regen(12) Batt/Richtung CRC-8 */
+static int cmt_d_wh1080(int d, cmt_bb_t *bb)
+{
+	static const uint16_t dir[16] = { 0, 23, 45, 68, 90, 113, 135, 158, 180, 203, 225, 248, 270, 293, 315, 338 };
+	int r;
+	uint8_t br[11];
+	cmt_rec_t *const op = &s_rec;
+
+	for(r = 0; r < bb->nrows; r++)
+	{
+		if(bb->bits[r] < 87 || bb->bits[r] > 99)
+			continue;
+		if(bb->bits[r] == 87)
+		{
+			bb_bytes(bb, r, 7, br + 1, 10);
+			br[0] = 0xFF;
+		}
+		else
+			bb_bytes(bb, r, 0, br, 11);
+		if(br[0] != 0xFF || cmt_crc8(br, 11, 0x31, 0xFF) != 0 || (br[1] >> 4) != 0xA)
+			continue;
+		rec_init(op, d);
+		rec_hex(op, "Id", (uint32_t)(((br[1] & 0x0F) << 4) | (br[2] >> 4)), 2);
+		rec_int(op, "Battery", (br[9] >> 4) == 1 ? 0 : 1);
+		rec_tenth(op, "Temperature", (((br[2] & 0x03) << 8) | br[3]) - 400);
+		rec_int(op, "Humidity", br[4]);
+		rec_tenth(op, "WindAvg", br[5] * 34 / 10);            /* m/s */
+		rec_tenth(op, "WindGust", br[6] * 34 / 10);
+		rec_int(op, "WindDir", dir[br[9] & 0x0F]);
+		rec_tenth(op, "Rain", (((br[7] & 0x0F) << 8) | br[8]) * 3); /* mm */
+		return cmt_emit(op);
+	}
+	return 0;
+}
