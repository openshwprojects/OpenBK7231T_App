+
+## 8. openHAB
+
+Voraussetzungen: das **MQTT Binding** und die Transformation **JSONPath** (für JS-Filter zusätzlich **JavaScript Scripting**).
+
+### 8.1 Things (`things/sh4.things`)
+
+```java
+Bridge mqtt:broker:mosquitto "Mosquitto" [ host="192.168.0.200", port=1883 ] {
+
+    Thing topic sh4bridge1 "SH4 Bridge 1" {
+    Channels:
+        // alle Sensor-Telegramme roh - die Zuordnung zu einzelnen Sensoren macht die Regel in 8.3
+        Type string : rfsensor "RF Sensor roh"     [ stateTopic="wlan2mqtt/irrfbridge1/RfSensor" ]
+        Type string : rfcode   "RF Code"           [ stateTopic="wlan2mqtt/irrfbridge1/RfCode/get" ]
+        Type string : rfproto  "RF Protokoll roh"  [ stateTopic="wlan2mqtt/irrfbridge1/RfProtocol" ]
+
+        // Senden
+        Type string : cmtsend   "RF senden"         [ commandTopic="cmnd/wlan2mqtt/irrfbridge1/cmtsend" ]
+        Type string : cmtkaku   "KaKu senden"       [ commandTopic="cmnd/wlan2mqtt/irrfbridge1/cmtkaku" ]
+        Type string : cmtsensor "Virt. Sensor"      [ commandTopic="cmnd/wlan2mqtt/irrfbridge1/cmtsensor" ]
+        Type string : irsend    "IR senden"         [ commandTopic="cmnd/wlan2mqtt/irrfbridge1/IRSend" ]
+
+        // Funksteckdose als Schalter
+        Type switch : stehlampe "Stehlampe" [
+            commandTopic="cmnd/wlan2mqtt/irrfbridge1/cmtkaku",
+            on="1A2B3C 1 on", off="1A2B3C 1 off" ]
+    }
+}
+```
+
+> Einzelne Sensoren werden **per Regel** herausgefiltert (8.3) und nicht mit einem JSONPath-Filterausdruck im Channel. Ein Filter wie `$.RfSensor[?(@.Id=='3D')]` liefert je nach openHAB-Version eine Liste statt eines Werts und erzeugt Warnungen, wenn ein fremder Sensor sendet.
+
+### 8.2 Items (`items/sh4.items`)
+
+```java
+Number:Temperature WZ_Temp      "Wohnzimmer [%.1f °C]"  <temperature>
+Number:Dimensionless WZ_Feuchte "Feuchte [%d %%]"       <humidity>
+String  RF_Sensor_Roh   "RF Sensor [%s]"     { channel="mqtt:topic:mosquitto:sh4bridge1:rfsensor" }
+String  RF_Code         "RF Code [%s]"       { channel="mqtt:topic:mosquitto:sh4bridge1:rfcode" }
+String  RF_Senden       "RF senden"          { channel="mqtt:topic:mosquitto:sh4bridge1:cmtsend" }
+String  RF_VirtSensor   "Virt. Sensor"       { channel="mqtt:topic:mosquitto:sh4bridge1:cmtsensor" }
+String  IR_Senden       "IR senden"          { channel="mqtt:topic:mosquitto:sh4bridge1:irsend" }
+Switch  Stehlampe       "Stehlampe"          { channel="mqtt:topic:mosquitto:sh4bridge1:stehlampe" }
+Switch  Klingel         "Klingel"
+Number:Temperature Aussen_Temp "Außen [%.1f °C]"
+```
+
+### 8.3 Rules (`rules/sh4.rules`)
+
+```java
+// Klingel erkannt
+rule "RF Klingel"
+when
+    Item RF_Code received update "DEE308"
+then
+    Klingel.postUpdate(ON)
+    createTimer(now.plusSeconds(5), [ | Klingel.postUpdate(OFF) ])
+end
+
+// Klingel per Funk auslösen (z. B. über einen Schalter in der UI)
+rule "Klingel senden"
+when
+    Item Klingel received command ON
+then
+    RF_Senden.sendCommand("DEE308 20000 450 1450 20")
+end
+
+// Sensor-Telegramme den Items zuordnen (Protocol + Id)
+rule "RF Sensor auswerten"
+when
+    Item RF_Sensor_Roh received update
+then
+    val json = RF_Sensor_Roh.state.toString
+    val id = transform("JSONPATH", "$.RfSensor.Id", json)
+    val proto = transform("JSONPATH", "$.RfSensor.Protocol", json)
+    if (proto == "Nexus" && id == "3D") {
+        WZ_Temp.postUpdate(transform("JSONPATH", "$.RfSensor.Temperature", json) + " °C")
+        WZ_Feuchte.postUpdate(transform("JSONPATH", "$.RfSensor.Humidity", json) + " %")
+    }
+    // weitere Sensoren: weitere if-Zweige mit Protocol/Id
+end
+
+// Außentemperatur jede Minute an die Funk-Wetterstation (Kanal 2)
+rule "Virtueller Sensor"
+when
+    Time cron "0 * * ? * *"
+then
+    if (Aussen_Temp.state instanceof QuantityType) {
+        val t = (Aussen_Temp.state as QuantityType<Number>).doubleValue
+        RF_VirtSensor.sendCommand(String::format(java.util.Locale.ROOT,
+            "{\"Channel\":2,\"Temperature\":%.1f,\"Id\":\"5A\",\"Interval\":60,\"Protocol\":\"Nexus\"}", t))
+    }
+end
+```
+
+---
+
+## 9. IR (Infrarot) auf dem SH4
+
+Der SH4 hat zusätzlich einen IR-Sender (P7) und einen IR-Empfänger (P8). Dafür ist der OBK-Treiber `IR` zuständig.
+
+```text
+startDriver IR
+IRSend NEC-1-1A-0           # Protokoll-Adresse-Befehl-Wiederholungen
+IRSend Samsung-7-2-0
+IRSend Sony-1-15-0
+```
+
+Empfangene Codes stehen im Log (`IR_NEC 0x1 0x1A 0 (32 bits)`). Per MQTT nach `<topic>/ir/get` gehen sie, wenn das OBK-Flag 14 („IR publish received“) gesetzt ist (*Config → General/Flags*).
+
+### IR-Empfänger abschalten
+
+**Ein IR-Empfänger, der Fremdlicht abbekommt, belegt fast die ganze CPU.** Ursachen können LED- oder Energiesparlampen, Fernseher, IR-Bewegungsmelder oder Kameras mit IR-Licht sein. Das Gerät wird dann träge, HTTP, MQTT und OTA scheitern, und der Heap fällt bis zum Neustart. Erkennbar ist das an `idle` unter ~10 000/s im Log, das sich nach `stopDriver IR` normalisiert.
+
+Abhilfe, wenn der Standort nicht geändert werden kann:
+
+```text
+IREnable RX 0       # IR-Empfänger aus, Senden geht weiter (in autoexec.bat nach startDriver IR)
+IREnable RX 1       # wieder ein
+```
+
+---
+
+## 10. Grenzen und bekannte Probleme
+
+- **Nur OOK/ASK.** FSK-Sensoren werden nicht empfangen. Das betrifft viele 868-MHz-Geräte, Bresser 5in1/6in1/7in1 und LaCrosse IT+.
+- **Senden sehr kurzer Pulse:** TX141TH (208 µs) und Bresser3CH (250 µs) lassen sich mit `cmtsensor` nicht zuverlässig senden. Der Sender gibt Zeiten im 50-µs-Raster aus. Der **Empfang** dieser Protokolle funktioniert.
+- **Somfy RTS** sendet auf 433,42 MHz statt 433,92 MHz und wird deshalb nur auf kurze Entfernung empfangen. Mit `cmtfreq` lässt sich die Frequenz verschieben, das ist aber nicht getestet. Andere Geräte würden dann schlechter empfangen.
+- **Gleichzeitige Telegramme:** Kommen zwei längere Telegramme sehr dicht hintereinander, kann das zweite verloren gehen (`verworfen(belegt)` in `cmtproto`). Kurze Pakete puffert der Treiber zwischen.
+- **Speicher:** Im Ruhezustand sind ~47–49 KB Heap frei. Dauerhaft offene Web-App-Tabs oder ein gestörter IR-Empfänger können das Gerät unter die 25-KB-Neustartgrenze drücken.
+- **Doppelte Topics:** Sensor-Topics kommen mit und ohne `/get`. Auf eines davon festlegen.
diff --git a/src/driver/cmt2300a.c b/src/driver/cmt2300a.c
new file mode 100644
index 00000000..d9ddb01a
--- /dev/null
+++ b/src/driver/cmt2300a.c
@@ -0,0 +1,165 @@
+#include "cmt2300a.h"
+#include "cmt2300a_defs.h"
+
+/* Von drv_cmt2300a.c bereitgestellt (Bit-Bang-SPI) */
+extern void cmt_spi3_write_fifo(const BYTE *buf, WORD len);
+extern void cmt_spi3_read_fifo(BYTE *buf, WORD len);
+
+void CMT2300A_SoftReset(void)
+{
+	CMT2300A_WriteReg(0x7F, 0xFF);
+}
+
+BYTE CMT2300A_GetChipStatus(void)
+{
+	return CMT2300A_ReadReg(CMT2300A_CUS_MODE_STA) & CMT2300A_MASK_CHIP_MODE_STA;
+}
+
+BOOL CMT2300A_WaitState(BYTE target, int timeout_ms)
+{
+	while(timeout_ms-- > 0)
+	{
+		if(CMT2300A_GetChipStatus() == target)
+			return TRUE;
+		CMT2300A_DelayMs(1);
+	}
+	return (CMT2300A_GetChipStatus() == target) ? TRUE : FALSE;
+}
+
+/* Kommando schreiben und warten, bis der Chip den Zielzustand erreicht hat */
+static BOOL CMT2300A_SwitchState(BYTE cmd, BYTE target)
+{
+	CMT2300A_WriteReg(CMT2300A_CUS_MODE_CTL, cmd);
+	return CMT2300A_WaitState(target, 50);
+}
+
+BOOL CMT2300A_GoSleep(void) { return CMT2300A_SwitchState(CMT2300A_GO_SLEEP, CMT2300A_STA_SLEEP); }
+BOOL CMT2300A_GoStby(void)  { return CMT2300A_SwitchState(CMT2300A_GO_STBY,  CMT2300A_STA_STBY);  }
+BOOL CMT2300A_GoRFS(void)   { return CMT2300A_SwitchState(CMT2300A_GO_RFS,   CMT2300A_STA_RFS);   }
+BOOL CMT2300A_GoTFS(void)   { return CMT2300A_SwitchState(CMT2300A_GO_TFS,   CMT2300A_STA_TFS);   }
+BOOL CMT2300A_GoRx(void)    { return CMT2300A_SwitchState(CMT2300A_GO_RX,    CMT2300A_STA_RX);    }
+BOOL CMT2300A_GoTx(void)    { return CMT2300A_SwitchState(CMT2300A_GO_TX,    CMT2300A_STA_TX);    }
+
+void CMT2300A_Init(void)
+{
+	BYTE tmp;
+
+	CMT2300A_SoftReset();
+	CMT2300A_DelayMs(20);
+	CMT2300A_GoStby();
+
+	tmp = CMT2300A_ReadReg(CMT2300A_CUS_MODE_STA);
+	tmp |= CMT2300A_MASK_CFG_RETAIN;
+	tmp &= ~CMT2300A_MASK_RSTN_IN_EN;
+	CMT2300A_WriteReg(CMT2300A_CUS_MODE_STA, tmp);
+
+	tmp = CMT2300A_ReadReg(CMT2300A_CUS_EN_CTL);
+	tmp |= CMT2300A_MASK_LOCKING_EN;
+	CMT2300A_WriteReg(CMT2300A_CUS_EN_CTL, tmp);
+}
+
+BOOL CMT2300A_ConfigRegBank(BYTE base_addr, const BYTE bank[], BYTE len)
+{
+	BYTE i;
+
+	for(i = 0; i < len; i++)
+		CMT2300A_WriteReg(base_addr + i, bank[i]);
+	return TRUE;
+}
+
+/* ---- FIFO (nur fuer spaeteren Packet Mode / TX, im Direct Mode ungenutzt) ---- */
+
+void CMT2300A_EnableReadFifo(void)
+{
+	BYTE reg = CMT2300A_ReadReg(CMT2300A_CUS_FIFO_CTL);
+	reg |= CMT2300A_MASK_SPI_FIFO_RD_WR_SEL;
+	CMT2300A_WriteReg(CMT2300A_CUS_FIFO_CTL, reg);
+}
+
+void CMT2300A_EnableWriteFifo(void)
+{
+	BYTE reg = CMT2300A_ReadReg(CMT2300A_CUS_FIFO_CTL);
+	reg &= ~CMT2300A_MASK_SPI_FIFO_RD_WR_SEL;
+	CMT2300A_WriteReg(CMT2300A_CUS_FIFO_CTL, reg);
+}
+
+void CMT2300A_ClearRxFifo(void)
+{
+	CMT2300A_WriteReg(CMT2300A_CUS_FIFO_CLR, CMT2300A_MASK_FIFO_CLR_RX);
+	CMT2300A_WriteReg(CMT2300A_CUS_FIFO_CLR, 0);
+}
+
+void CMT2300A_ClearTxFifo(void)
+{
+	CMT2300A_WriteReg(CMT2300A_CUS_FIFO_CLR, CMT2300A_MASK_FIFO_CLR_TX);
+	CMT2300A_WriteReg(CMT2300A_CUS_FIFO_CLR, 0);
+}
+
+void CMT2300A_WriteFifo(const BYTE *buf, WORD len)
+{
+	cmt_spi3_write_fifo(buf, len);
+}
+
+void CMT2300A_ReadFifo(BYTE *buf, WORD len)
+{
+	cmt_spi3_read_fifo(buf, len);
+}
+
+/* GPIO1 = DCLK, GPIO2 = DOUT, GPIO3 = INT2  (IO_SEL = 0x2B) */
+void CMT2300A_ConfigGpio(void)
+{
+	BYTE reg = 0;
+
+	reg |= CMT2300A_GPIO1_SEL_DCLK;
+	reg |= CMT2300A_GPIO2_SEL_DOUT;
+	reg |= CMT2300A_GPIO3_SEL_INT2;
+	CMT2300A_WriteReg(CMT2300A_CUS_IO_SEL, reg);
+}
+
+void CMT2300A_ConfigInterrupt(void)
+{
+	CMT2300A_WriteReg(CMT2300A_CUS_INT1_CTL, CMT2300A_INT_SEL_RX_FIFO_TH);
+	CMT2300A_WriteReg(CMT2300A_CUS_INT2_CTL, CMT2300A_INT_SEL_PKT_OK);
+}
+
+BYTE CMT2300A_ClearInterruptFlags(void)
+{
+	BYTE flags = CMT2300A_ReadReg(CMT2300A_CUS_INT_CLR1);
+
+	CMT2300A_WriteReg(CMT2300A_CUS_INT_CLR1, 0xFF);
+	CMT2300A_WriteReg(CMT2300A_CUS_INT_CLR2, 0xFF);
+	return flags;
+}
+
+/* ---- Konfig-Helfer aus dem Hersteller-Ablauf (radio.c: RF_Config) ---- */
+
+void CMT2300A_EnableInterrupt(BYTE mask)
+{
+	CMT2300A_WriteReg(CMT2300A_CUS_INT_EN, mask);
+}
+
+void CMT2300A_EnableLfosc(BOOL enable)
+{
+	BYTE tmp = CMT2300A_ReadReg(CMT2300A_CUS_SYS2);
+	BYTE m = CMT2300A_MASK_LFOSC_RECAL_EN | CMT2300A_MASK_LFOSC_CAL1_EN | CMT2300A_MASK_LFOSC_CAL2_EN;
+
+	if(enable) tmp |= m; else tmp &= ~m;
+	CMT2300A_WriteReg(CMT2300A_CUS_SYS2, tmp);
+}
+
+void CMT2300A_EnableFifoMerge(BOOL enable)
+{
+	BYTE tmp = CMT2300A_ReadReg(CMT2300A_CUS_FIFO_CTL);
+
+	if(enable) tmp |= CMT2300A_MASK_FIFO_MERGE_EN; else tmp &= ~CMT2300A_MASK_FIFO_MERGE_EN;
+	CMT2300A_WriteReg(CMT2300A_CUS_FIFO_CTL, tmp);
+}
+
+void CMT2300A_SetFifoThreshold(BYTE th)
+{
+	BYTE tmp = CMT2300A_ReadReg(CMT2300A_CUS_PKT29);
+
+	tmp &= ~CMT2300A_MASK_FIFO_TH;
+	tmp |= (th & CMT2300A_MASK_FIFO_TH);
+	CMT2300A_WriteReg(CMT2300A_CUS_PKT29, tmp);
+}
