+/* Acurite 592TXR (nach Invertierung): KK+ID(14) pB 000100 pHumidity pTemp pTemp Summe */
+static int cmt_d_acuritetxr(int d, cmt_bb_t *bb)
+{
+	static const int8_t chmap[4] = { 3, -1, 2, 1 };    /* 00 = C, 10 = B, 11 = A */
+	int r, raw, ch;
+	uint8_t b[7];
+	cmt_rec_t *const op = &s_rec;
+
+	bb_invert(bb);
+	for(r = 0; r < bb->nrows; r++)
+	{
+		if(bb->bits[r] < 56 || bb->bits[r] > 80)
+			continue;
+		bb_bytes(bb, r, 0, b, 7);
+		if((b[2] & 0x3F) != 0x04 || (uint8_t)(b[0] + b[1] + b[2] + b[3] + b[4] + b[5]) != b[6])
+			continue;
+		if(cmt_par8((uint8_t)(b[2] ^ b[3] ^ b[4] ^ b[5])))
+			continue;
+		ch = chmap[b[0] >> 6];
+		raw = ((b[4] & 0x7F) << 7) | (b[5] & 0x7F);
+		if(ch < 0 || ((b[3] & 0x7F) > 100 && (b[3] & 0x7F) != 127) || raw - 1000 < -400 || raw - 1000 > 700)
+			continue;
+		rec_init(op, d);
+		rec_sensor(op, ((b[0] & 0x3F) << 8) | b[1], 4, ch, (b[2] >> 6) & 1);
+		rec_tenth(op, "Temperature", raw - 1000);
+		if((b[3] & 0x7F) != 127) rec_int(op, "Humidity", b[3] & 0x7F);
+		return cmt_emit(op);
+	}
+	return 0;
+}
