+/* ---- Manchester aus PCM-Zeilen (Halbbits) ----
+ * Bits ab Halbbit start: (H,L) = 1, (L,H) = 0 ("fallende Flanke = 1"), sonst 2 = ungueltig.
+ * Vor jeder Zeile steht gedanklich ein Low-Halbbit (Stille): start = -1 nutzt es. */
+static uint8_t s_mb[CMT_BB_BITS / 2 + 1];
+
+static int cmt_man_bits(const cmt_bb_t *bb, int r, int start)
+{
+	int i, n = 0;
+
+	for(i = start; i + 1 < bb->bits[r] + 1 && n < (int)sizeof(s_mb); i += 2)
+	{
+		int a = bb_get(bb, r, i), b = bb_get(bb, r, i + 1);
+
+		s_mb[n++] = (a == b) ? 2 : (uint8_t)a;
+	}
+	return n;
+}
+
+static int cmt_mbit(int i, int inv) { return s_mb[i] == 2 ? -1 : (s_mb[i] ^ inv); }
+
+/* F007TH: Muster 0000 0001 0100, ab +8: 45 ID Batt/Kanal-1(3)/T T Feuchte LFSR8(0x98,0x3E)^0x64; Temp 0,1 F + 40 F */
+static int cmt_f007_try(int d, int n, int inv)
+{
+	static const uint16_t pat = 0x014;
+	int i, j, k;
+
+	for(i = 0; i + 8 + 48 <= n; i++)
+	{
+		uint8_t b[6];
+		int ok = 1, t;
+		cmt_rec_t *const op = &s_rec;
+
+		for(j = 0; j < 12 && ok; j++)
+			if(cmt_mbit(i + j, inv) != ((pat >> (11 - j)) & 1))
+				ok = 0;
+		if(!ok)
+			continue;
+		memset(b, 0, sizeof(b));
+		for(k = 0; k < 48 && ok; k++)
+		{
+			int v = cmt_mbit(i + 8 + k, inv);
+
+			if(v < 0) ok = 0;
+			else if(v) b[k >> 3] |= (uint8_t)(0x80 >> (k & 7));
+		}
+		if(!ok || (uint8_t)(cmt_lfsr8(b, 5, 0x98, 0x3E) ^ 0x64) != b[5])
+			continue;
+		t = cmt_f2c((((b[2] & 0x0F) << 8) | b[3]) - 400);
+		if(b[4] > 100 || t < -400 || t > 1000)
+			continue;
+		rec_init(op, d);
+		rec_sensor(op, b[1], 2, ((b[2] >> 4) & 7) + 1, (b[2] & 0x80) ? 0 : 1);
+		rec_tenth(op, "Temperature", t);
+		rec_int(op, "Humidity", b[4]);
+		return cmt_emit(op);
+	}
+	return 0;
+}
+
+static int cmt_d_f007(int d, cmt_bb_t *bb)
+{
+	int r, st, inv, n;
+
+	for(r = 0; r < bb->nrows; r++)
+	{
+		if(bb->bits[r] < 100)
+			continue;
+		for(st = -1; st <= 0; st++)
+		{
+			n = cmt_man_bits(bb, r, st);
+			for(inv = 0; inv < 2; inv++)
+				if(cmt_f007_try(d, n, inv))
+					return 1;
+		}
+	}
+	return 0;
+}
+
+/* Oregon Scientific v2.1 (jedes Bit doppelt) und v3: Praeambel >= 12 x 1, Sync A (LSB zuerst 0101),
+ * Nibbles LSB zuerst: n0..3 Sensor-ID, n4 Kanal, n5..6 Rollcode, n7 Flags (Bit 2 = Batt. schwach),
+ * n8..10 Temp BCD, n11 Vorzeichen, n12..13 Feuchte BCD. Pruefsumme = Summe der Nibbles
+ * n0..n11 -> n12/13 (nur Temperatur) bzw. n0..n14 -> n15/16. Unbekannte Modelle: Rohdaten. */
+static int cmt_oregon_try(int dv, int n, int off, int inv)
+{
+	static uint8_t dd[CMT_BB_BITS / 4 + 1];
+	static int nib[24];
+	int m = 0, i, s, ones = 0, nn = 0, k;
+
+	if(off >= 0)
+	{
+		for(i = off; i + 1 < n && m < (int)sizeof(dd); i += 2)
+		{
+			int a = cmt_mbit(i, inv), b = cmt_mbit(i + 1, inv);
+
+			dd[m++] = (a < 0 || b < 0 || a == b) ? 2 : (uint8_t)b;
+		}
+	}
+	else
+		for(i = 0; i < n && m < (int)sizeof(dd); i++)
+		{
+			int a = cmt_mbit(i, inv);
+
+			dd[m++] = a < 0 ? 2 : (uint8_t)a;
+		}
+	for(s = 0; s + 4 <= m; s++)
+	{
+		if(dd[s] == 1) { ones++; continue; }
+		if(ones >= 12 && dd[s] == 0 && dd[s + 1] == 1 && dd[s + 2] == 0 && dd[s + 3] == 1)
+			break;
+		ones = 0;
+	}
+	if(s + 4 > m)
+		return 0;
+	s += 4;
+	while(nn < 24 && s + 4 <= m)
+	{
+		int v = 0;
+
+		for(k = 0; k < 4; k++)
+		{
+			if(dd[s + k] == 2) { v = -1; break; }
+			v |= dd[s + k] << k;
+		}
+		if(v < 0) break;
+		nib[nn++] = v;
+		s += 4;
+	}
+	for(k = 0; k < 2; k++)
+	{
+		int last = k ? 14 : 11, sum = 0;
+		cmt_rec_t *const op = &s_rec;
+		char model[5];
+
+		if(nn < last + 3)
+			continue;
+		for(i = 0; i <= last; i++)
+			sum += nib[i];
+		if((sum & 0xFF) != (nib[last + 1] | (nib[last + 2] << 4)))
+			continue;
+		snprintf(model, sizeof(model), "%X%X%X%X", nib[0], nib[1], nib[2], nib[3]);
+		rec_init(op, dv);
+		rec_hex(op, "Model", (uint32_t)((nib[0] << 12) | (nib[1] << 8) | (nib[2] << 4) | nib[3]), 4);
+		rec_hex(op, "Id", (uint32_t)((nib[6] << 4) | nib[5]), 2);
+		rec_int(op, "Channel", (nib[4] == 4) ? 3 : (nib[4] == 2 ? 2 : (nib[4] == 1 ? 1 : nib[4])));
+		rec_int(op, "Battery", (nib[7] & 0x4) ? 0 : 1);
+		if(nib[8] <= 9 && nib[9] <= 9 && nib[10] <= 9)
+		{
+			int t = nib[10] * 100 + nib[9] * 10 + nib[8];
+
+			rec_tenth(op, "Temperature", (nib[11] & 0x8) ? -t : t);
+			if(k && nib[12] <= 9 && nib[13] <= 9)
+				rec_int(op, "Humidity", nib[13] * 10 + nib[12]);
+		}
+		else
+		{
+			/* andere Messgroessen (Wind, Regen, UV ...): Nibbles als Rohdaten */
+			int q = 0;
+
+			for(i = 0; i <= last + 2 && q < (int)sizeof(op->data) - 1; i++)
+				op->data[q++] = "0123456789ABCDEF"[nib[i]];
+			op->data[q] = 0;
+			op->bits = (last + 3) * 4;
+		}
+		(void)model;
+		return cmt_emit(op);
+	}
+	return 0;
+}
+
+static int cmt_d_oregon(int d, cmt_bb_t *bb)
+{
+	int r, st, inv, off, n;
+
+	for(r = 0; r < bb->nrows; r++)
+	{
+		if(bb->bits[r] < 120)
+			continue;
+		for(st = -1; st <= 0; st++)
+		{
+			n = cmt_man_bits(bb, r, st);
+			for(inv = 0; inv < 2; inv++)
+				for(off = -1; off < 2; off++)
+					if(cmt_oregon_try(d, n, off, inv))
+						return 1;
+		}
+	}
+	return 0;
+}
+
+/* Somfy RTS: Software-Sync (>= 7 x 1 nach Low), danach 56 Bit Manchester (L,H = 1),
+ * entschluesseln b[i] ^= b[i-1] (6..1), XOR aller Nibbles = 0 */
+static int cmt_d_somfy(int d, cmt_bb_t *bb)
+{
+	static const char *const ctl[16] = { "?", "My", "Up", "My+Up", "Down", "My+Down", "Up+Down", "My+Up+Down",
+		"Prog", "Sun+Flag", "Flag", "?", "?", "?", "?", "?" };
+	int r, i, run, st, k;
+
+	for(r = 0; r < bb->nrows; r++)
+	{
+		if(bb->bits[r] < 120)
+			continue;
+		for(i = 4, run = 0; i < bb->bits[r]; i++)
+		{
+			if(bb_get(bb, r, i)) { run++; continue; }
+			if(run >= 6 && run <= 9 && !bb_get(bb, r, i - run - 1))
+			{
+				for(st = i; st <= i + 1; st++)
+				{
+					uint8_t b[7], x = 0;
+					int ok = 1;
+					cmt_rec_t *const op = &s_rec;
+
+					if(st + 112 > bb->bits[r])
+						continue;
+					memset(b, 0, sizeof(b));
+					for(k = 0; k < 56 && ok; k++)
+					{
+						int a = bb_get(bb, r, st + 2 * k), c = bb_get(bb, r, st + 2 * k + 1);
+
+						if(a == c) ok = 0;
+						else if(!a) b[k >> 3] |= (uint8_t)(0x80 >> (k & 7));
+					}
+					if(!ok)
+						continue;
+					for(k = 6; k >= 1; k--)
+						b[k] ^= b[k - 1];
+					for(k = 0; k < 7; k++)
+						x ^= b[k];
+					if(((x >> 4) ^ (x & 0x0F)) != 0)
+						continue;
+					rec_init(op, d);
+					rec_hex(op, "Id", (uint32_t)((b[6] << 16) | (b[5] << 8) | b[4]), 6);
+					rec_str(op, "Cmd", ctl[b[1] >> 4]);
+					rec_int(op, "Counter", (b[2] << 8) | b[3]);
+					rec_hex(op, "Key", b[0], 2);
+					return cmt_emit(op);
+				}
+			}
+			run = 0;
+		}
+	}
+	return 0;
+}
+
+/* Intertechno selbstlernend / KlikAanKlikUit / Nexa: Sync, 32 Paare (+4 Dimmwert),
+ * Paar (0,1) = 0, (1,0) = 1, (0,0) an Stelle 27 = Dimmen. ID(26) Gruppe(1) An(1) Einheit(4) [Dimm(4)] */
+static int cmt_d_newkaku(int d, cmt_bb_t *bb)
+{
+	static const char *const cmd[3] = { "Off", "On", "Dim" };
+	int r, i, nb, dim, v[36];
+	uint32_t id;
+	cmt_rec_t *const op = &s_rec;
+
+	for(r = 0; r < bb->nrows; r++)
+	{
+		if(!bb->syncs[r] || (bb->bits[r] != 64 && bb->bits[r] != 72))
+			continue;
+		nb = bb->bits[r] / 2;
+		dim = 0;
+		for(i = 0; i < nb; i++)
+		{
+			int a = bb_get(bb, r, 2 * i), b = bb_get(bb, r, 2 * i + 1);
+
+			if(a != b) v[i] = a;
+			else if(i == 27 && !a) { v[i] = 0; dim = 1; }
+			else break;
+		}
+		if(i < nb)
+			continue;
+		for(id = 0, i = 0; i < 26; i++)
+			id = (id << 1) | (uint32_t)v[i];
+		rec_init(op, d);
+		rec_hex(op, "Id", id, 7);
+		rec_int(op, "Unit", ((v[28] << 3) | (v[29] << 2) | (v[30] << 1) | v[31]) + 1);
+		rec_int(op, "Group", v[26]);
+		rec_str(op, "Cmd", cmd[dim ? 2 : v[27]]);
+		if(nb == 36)
+			rec_int(op, "DimLevel", (v[32] << 3) | (v[33] << 2) | (v[34] << 1) | v[35]);
+		rec_data(op, bb, r, 0, bb->bits[r]);
+		return cmt_emit(op);
+	}
+	return 0;
+}
+
+/* X10 RF: 32 Bit, b0 ^ b1 = FF, b2 ^ b3 = FF */
+static int cmt_d_x10(int d, cmt_bb_t *bb)
+{
+	static const char house[] = "MNOPCDABEFGHKLIJ";
+	int r, unit;
+	uint8_t b[4];
+	char *hs;
+	static char hbuf[2];
+	cmt_rec_t *const op = &s_rec;
+
+	for(r = 0; r < bb->nrows; r++)
+	{
+		if(bb->bits[r] != 32)
+			continue;
+		bb_bytes(bb, r, 0, b, 4);
+		if((uint8_t)(b[0] ^ b[1]) != 0xFF || (uint8_t)(b[2] ^ b[3]) != 0xFF)
+			continue;
+		if((b[0] & 0x0B) != 0 || (b[1] & 0x0B) != 0x0B || (b[2] & 0x07) != 0 || (b[3] & 0x07) != 0x07)
+			continue;
+		hbuf[0] = house[b[0] >> 4];
+		hbuf[1] = 0;
+		hs = hbuf;
+		rec_init(op, d);
+		rec_str(op, "House", hs);
+		if(!(b[2] & 0x80))
+		{
+			unit = 1 + (((b[0] >> 2) & 1) << 3) + (((b[2] >> 6) & 1) << 2) + (((b[2] >> 3) & 1) << 1) + ((b[2] >> 4) & 1);
+			rec_int(op, "Unit", unit);
+			rec_str(op, "Cmd", (b[2] & 0x20) ? "Off" : "On");
+		}
+		else
+			rec_str(op, "Cmd", b[2] == 0x98 ? "Dim" : b[2] == 0x88 ? "Bright" : b[2] == 0x90 ? "AllLightsOn" : b[2] == 0x80 ? "AllOff" : "?");
+		rec_data(op, bb, r, 0, 32);
+		return cmt_emit(op);
+	}
+	return 0;
+}
+
+/* rc-switch (strenge Periode): 12..64 Bit, zwei gleiche Zeilen. 24 Bit meldet bereits RfReceived. */
+static int cmt_d_rcs(int d, cmt_bb_t *bb)
+{
+	int r = bb_repeated(bb, 2, 12), nb, k, ok = 1;
+	char tri[33];
+	cmt_rec_t *const op = &s_rec;
+
+	if(r < 0)
+		return 0;
+	nb = bb->bits[r];
+	if(nb == 24 || nb > 64)
+		return 0;
+	rec_init(op, d);
+	rec_data(op, bb, r, 0, nb);
+	if(!(nb & 1) && nb <= 64)
+	{
+		for(k = 0; k < nb / 2; k++)
+		{
+			int a = bb_get(bb, r, 2 * k), b = bb_get(bb, r, 2 * k + 1);
+
+			tri[k] = (!a && !b) ? '0' : (a && b) ? '1' : (!a && b) ? 'F' : '?';
+			if(a && !b) ok = 0;
+		}
+		tri[nb / 2] = 0;
+		if(ok)
+			rec_str(op, "Tristate", tri);
+	}
+	return cmt_emit(op);
+}
+
+/* eigene Geraete: passende Zeile (Bitzahl, Wiederholungen) als Rohdaten melden */
+static int cmt_d_flex(int d, cmt_bb_t *bb)
+{
+	int i = d - CMT_D_N, r;
+	cmt_rec_t *const op = &s_rec;
+
+	if(i < 0 || i >= CMT_FLEX_N)
+		return 0;
+	r = bb_repeated(bb, s_flex[i].minRep ? s_flex[i].minRep : 1, s_flex[i].bMin);
+	if(r < 0 || bb->bits[r] > s_flex[i].bMax)
+		return 0;
+	rec_init(op, d);
+	rec_data(op, bb, r, 0, bb->bits[r]);
+	return cmt_emit(op);
+}
+
+/* Frame entprellen: erst ab dem 2. identischen Frame einer Serie melden */
+static void cmt_on_frame(const cmt_frame_t *f)
+{
+	uint32_t now = rtos_get_time();
+	uint32_t d = f->data & 0xFFFFFF;
+
+	s_statFrames++;
+	if(d == s_lastData && (now - s_lastFrameMs) < CMT_BURST_GAP_MS)
+		s_sameCnt++;
+	else
+	{
+		s_sameCnt = 1;
+		s_lastData = d;
+	}
+	s_lastFrameMs = now;
+
+	if(s_sameCnt >= 2 && (s_lastCode != d || (now - s_lastReportMs) > CMT_REPORT_GAP_MS))
+	{
+		s_lastCode = d;
+		s_lastReportMs = now;
+		s_lastSync = f->syncUs; s_lastLow = f->shortUs; s_lastHigh = f->longUs;
+		s_lastL0 = f->low0Us; s_lastL1 = f->low1Us; s_lastMerged = f->merged;
+		s_statReports++;
+		cmt_publish(f);
+	}
+}
